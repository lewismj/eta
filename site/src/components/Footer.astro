---
import "../styles/global.css";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} The Eta Authors. MIT License.</span>
  <div class="footer-links">
    <a href={`${base}docs/quickstart/`}>Docs</a>
    <a href="https://github.com/lewismj/eta" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={`${base}docs/release-notes/`}>Release Notes</a>
  </div>
</footer>

