---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import "../styles/global.css";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");

const features = [
  {
    title: "Symbolic Lisp core",
    body: "NaN-boxed VM, tail-call optimisation, hygienic syntax-rules macros, structural unification, and native backtracking opcodes for Prolog-style logic.",
    href: `${base}docs/language-guide/`,
    linkLabel: "Language guide",
  },
  {
    title: "Logic & CLP",
    body: "Built-in unification and backtracking as first-class VM primitives — constraint logic programming without an external solver.",
    href: `${base}docs/stdlib/logic/`,
    linkLabel: "std.logic",
  },
  {
    title: "AAD",
    body: "Native reverse-mode Automatic Adjoint Differentiation (AAD) integrated into the runtime — transparent gradient computation with zero closure overhead.",
    href: `${base}docs/stdlib/aad/`,
    linkLabel: "std.aad",
  },
  {
    title: "Neural networks",
    body: "First-class C++ bindings to libtorch for neural networks and Eigen for linear algebra and statistics — delivered as native sidecars.",
    href: `${base}docs/stdlib/torch/`,
    linkLabel: "std.torch",
  },
  {
    title: "Causal inference",
    body: "Built-in Pearl's do-calculus — identification algorithms, do-interventions, and counterfactual queries in pure Eta.",
    href: `${base}docs/stdlib/causal/`,
    linkLabel: "std.causal",
  },
  {
    title: "Actor-model concurrency",
    body: "Erlang-style actors and message passing via nng — network-transparent parallelism, supervision trees, and pub/sub.",
    href: `${base}docs/stdlib/supervisor/`,
    linkLabel: "std.supervisor",
  },
];

const sampleCode = `(import std.core std.aad)

;; d₁ = [ln(S/K) + (r + σ²/2)·T] / (σ·√T)
(defun bs-d1 (S K r sigma T)
  (/ (+ (log (/ S K))
        (* (+ r (/ (* sigma sigma) 2)) T))
     (* sigma (sqrt T))))

;; C = S·Φ(d₁) − K·e^{-rT}·Φ(d₂)
(defun bs-call (S K r sigma T)
  (let ((d1 (bs-d1 S K r sigma T))
        (d2 (- (bs-d1 S K r sigma T) (* sigma (sqrt T)))))
    (- (* S (norm-cdf d1))
       (* (* K (exp (* -1 (* r T)))) (norm-cdf d2)))))

;; grad records the forward pass on a tape, then runs one
;; backward sweep — yielding price + all five Greeks at once.
(let* ((res    (grad (lambda (S K r sigma T) (bs-call S K r sigma T))
                     '(100.0 90.0 0.03 0.30 0.5)))
       (price  (car res))
       (greeks (cadr res)))
  (println "Price " price)
  (println "Delta " (vector-ref greeks 0))   ;; ∂C/∂S
  (println "Vega  " (vector-ref greeks 3))   ;; ∂C/∂σ
  (println "Rho   " (vector-ref greeks 2))   ;; ∂C/∂r
  (println "Theta " (vector-ref greeks 4)))  ;; ∂C/∂T`;
---

<BaseLayout
  title="Eta"
  description="A Lisp-inspired language for symbolic logic, constraint programming (CLP), differentiable programming, causal inference, and native-sidecar ML."
>
  <Header />

  <!-- Hero ─────────────────────────────────────── -->
  <Hero
    eyebrow="Open Source · v0.4"
    heading="Symbolic · Logic · Neural<br/><em>programming in Lisp.</em>"
    subheading="A Lisp-inspired language for unified symbolic reasoning, learning, and causal inference."
    primaryLabel="Get Started"
    primaryHref={`${base}docs/quickstart/`}
    secondaryLabel="Read the Guide"
    secondaryHref={`${base}docs/language-guide/`}
  />


  <!-- Feature cards ────────────────────────────── -->
  <CardGrid label="What Eta gives you">
    {features.map((f) => (
      <Card
        title={f.title}
        body={f.body}
        href={f.href}
        linkLabel={f.linkLabel}
      />
    ))}
  </CardGrid>

  <!-- Code sample ──────────────────────────────── -->
  <div class="code-section">
    <div class="code-section__copy">
      <p class="section-label">Language sample</p>
      <h2>Price and Greeks.<br/>One backward sweep.</h2>
      <p>
        <code>grad</code> records the Black-Scholes forward pass onto a flat
        tape — ~32 bytes per operation, zero closure allocations — then sweeps
        in reverse via the chain rule. Price plus all five Greeks fall out of
        a single call, regardless of how many inputs the function has.
      </p>
      <a href={`${base}docs/language-guide/`} class="btn btn-outline">
        AAD reference
      </a>
    </div>
    <pre><code set:html={sampleCode
      .replace(/;;.*$/gm, (m) => `<span class="tok-comment">${m}</span>`)
      .replace(/\b(defun|let\*?|lambda|import|begin|define|if|cond|and|or)\b/g,
               '<span class="tok-keyword">$1</span>')
      .replace(/\b(grad|norm-cdf|bs-d1|bs-call|vector-ref|println|log|exp|sqrt|car|cadr|cons|list|apply)\b/g,
               '<span class="tok-fn">$1</span>')
      .replace(/(?<![a-zA-Z\d])([\d]+\.[\d]*|\.[\d]+|[\d]+)(?![a-zA-Z\d])/g,
               '<span class="tok-num">$1</span>')
    } /></pre>
  </div>

  <!-- Native sidecar story ─────────────────────── -->
  <CardGrid label="Native sidecar ecosystem">
    <Card
      title="Torch NN"
      body="LibTorch tensor operations and autograd — loaded as a versioned, checksummed native sidecar."
      href={`${base}docs/stdlib/torch/`}
      linkLabel="std.torch"
    />
    <Card
      title="NNG Networking"
      body="nanomsg-next-gen messaging primitives for pub/sub, push/pull, and request/reply patterns."
      href={`${base}docs/stdlib/net/`}
      linkLabel="std.net"
    />
    <Card
      title="Eigen Numerics"
      body="Eigen-backed statistics and linear algebra — normal distribution, regression, and more."
      href={`${base}docs/stdlib/stats/`}
      linkLabel="std.stats"
    />
    <Card
      title="Logging"
      body="spdlog-backed structured logging with level control — the reference migration example."
      href={`${base}docs/stdlib/log/`}
      linkLabel="std.log"
    />
  </CardGrid>

  <!-- Cookbook highlights ──────────────────────── -->
  <CardGrid label="Cookbook highlights">
    <Card
      title="Quant workflows"
      body="European options, SABR calibration, XVA with WWR, portfolio LP, and automatic adjoint differentiation."
      href={`${base}cookbook/`}
      linkLabel="Open quant examples"
    />
    <Card
      title="Logic & constraint"
      body="N-queens, SEND+MORE=MONEY, boolean simplifier, symbolic differentiation, and unification."
      href={`${base}cookbook/`}
      linkLabel="Open logic examples"
    />
    <Card
      title="Causal inference"
      body="DAGs, do-calculus rules, and counterfactual queries in pure Eta."
      href={`${base}cookbook/`}
      linkLabel="Open causal examples"
    />
    <Card
      title="Concurrency"
      body="Worker pools, scatter-gather, distributed Monte Carlo, and reactive pub/sub over nng."
      href={`${base}cookbook/`}
      linkLabel="Open concurrency examples"
    />
  </CardGrid>

  <!-- Links row ────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <p class="section-label">Get involved</p>
    <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px,1fr));">
      <a href="https://github.com/lewismj/eta" target="_blank" rel="noopener noreferrer" class="card" style="text-decoration:none;">
        <div class="card__title"><span class="card__dot"></span>GitHub</div>
        <div class="card__body">Source, issues, and pull requests.</div>
      </a>
      <a href={`${base}docs/build/`} class="card" style="text-decoration:none;">
        <div class="card__title"><span class="card__dot"></span>Build guide</div>
        <div class="card__body">CMake setup for Windows, Linux, and macOS.</div>
      </a>
      <a href={`${base}docs/release-notes/`} class="card" style="text-decoration:none;">
        <div class="card__title"><span class="card__dot"></span>Release notes</div>
        <div class="card__body">What changed in each release.</div>
      </a>
      <a href={`${base}docs/next-steps/`} class="card" style="text-decoration:none;">
        <div class="card__title"><span class="card__dot"></span>Roadmap</div>
        <div class="card__body">What is planned next for the language.</div>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>

