---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import "../styles/global.css";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");


const features = [
  {
    title: "Lisp core",
    body: "Scheme-like VM. NaN-boxing, unification, backtracking.",
    href: `${base}docs/language-guide/`,
  },
  {
    title: "Differentiable execution",
    body: "Reverse-mode AAD, tape VM opcodes. libtorch, LightGBM, Eigen.",
    href: `${base}docs/guide/reference/aad/`,
  },
  {
    title: "Causal engine",
    body: "do-calculus. Identification. Counterfactuals.",
    href: `${base}docs/guide/reference/causal/`,
  },
  {
    title: "Actor system",
    body: "Network-transparent processes. Supervision. nng.",
    href: `${base}docs/guide/reference/message-passing/`,
  },
];

const ecosystem = [
  { label: "VS Code",  href: `${base}docs/editors/` },
  { label: "Jupyter",  href: `${base}docs/guide/reference/jupyter/` },
  { label: "Profiler", href: `${base}docs/guide/profiling/` },
  { label: "Packages", href: `${base}packages/` },
];

const sampleCode = `(import std.core std.aad)

;; d₁ = [ln(S/K) + (r + σ²/2)·T] / (σ·√T)
(defun bs-d1 (S K r sigma T)
  (/ (+ (log (/ S K))
        (* (+ r (/ (* sigma sigma) 2)) T))
     (* sigma (sqrt T))))

;; C = S·Φ(d₁) − K·e^{-rT}·Φ(d₂)
(defun bs-call (S K r sigma T)
  (let ((d1 (bs-d1 S K r sigma T))
        (d2 (- (bs-d1 S K r sigma T) (* sigma (sqrt T)))))
    (- (* S (norm-cdf d1))
       (* (* K (exp (* -1 (* r T)))) (norm-cdf d2)))))

;; grad records the forward pass on a tape, then runs one
;; backward sweep — yielding price + all five Greeks at once.
(let* ((res    (grad (lambda (S K r sigma T) (bs-call S K r sigma T))
                     '(100.0 90.0 0.03 0.30 0.5)))
       (price  (car res))
       (greeks (cadr res)))
  (println "Price " price)
  (println "Delta " (vector-ref greeks 0))   ;; ∂C/∂S
  (println "Vega  " (vector-ref greeks 3))   ;; ∂C/∂σ
  (println "Rho   " (vector-ref greeks 2))   ;; ∂C/∂r
  (println "Theta " (vector-ref greeks 4)))  ;; ∂C/∂T`;
---

<BaseLayout
  title="Eta"
  description="A Lisp-inspired language for symbolic logic, constraint programming (CLP), differentiable programming, causal inference, and native-sidecar ML."
>
  <Header />

  <!-- Hero ─────────────────────────────────────── -->
  <Hero
    eyebrow="Open Source · v0.0.1"
    heading="Symbolic · Logic · Neural · Causal<br/><em>programming in Lisp.</em>"
    subheading="A Lisp-inspired language for symbolic reasoning, learning, and causal inference."
    primaryLabel="Get Started"
    primaryHref={`${base}docs/quickstart/`}
    secondaryLabel="Read the guide"
    secondaryHref={`${base}docs/language-guide/`}
  />


  <!-- Feature cards — 2×2 thematic composition + ecosystem strip ─── -->
  <section class="section">
    <div class="card-grid card-grid--2col">
      {features.map((f) => (
        <Card
          title={f.title}
          body={f.body}
          href={f.href}
        />
      ))}
    </div>
    <p class="eco-strip">
      <span class="eco-strip__label">Ecosystem</span>
      {ecosystem.map((e, i) => (
        <>
          <span class="eco-strip__sep" aria-hidden="true">·</span>
          <a class="eco-strip__link" href={e.href}>{e.label}</a>
        </>
      ))}
    </p>
  </section>

  <!-- Dark anchor: interlude prose + language sample, side by side -->
  <section class="dark-anchor">
    <div class="dark-anchor__inner">
      <div class="dark-anchor__copy">
        <p class="dark-anchor__label">A differentiable Lisp</p>
        <h2 class="dark-anchor__lede">
          One runtime for symbolic reasoning, logic, differentiation
          and causal inference.
        </h2>
        <p class="dark-anchor__body">
          Eta embeds unification, backtracking, and reverse-mode
          differentiation directly into the VM. Constraints, macros,
          neural networks, and causal programs operate on the same
          execution model, value representation, and garbage collector.
        </p>
        <a href={`${base}docs/guide/reference/aad/`} class="dark-anchor__link">
          AAD reference
        </a>
      </div>
      <pre class="dark-anchor__code"><code set:html={sampleCode
        .replace(/;;.*$/gm, (m) => `<span class="tok-comment">${m}</span>`)
        .replace(/\b(defun|let\*?|lambda|import|begin|define|if|cond|and|or)\b/g,
                 '<span class="tok-keyword">$1</span>')
        .replace(/\b(grad|norm-cdf|bs-d1|bs-call|vector-ref|println|log|exp|sqrt|car|cadr|cons|list|apply)\b/g,
                 '<span class="tok-fn">$1</span>')
        .replace(/(?<![a-zA-Z\d])([\d]+\.[\d]*|\.[\d]+|[\d]+)(?![a-zA-Z\d])/g,
                 '<span class="tok-num">$1</span>')
      } /></pre>
    </div>
  </section>

  <!-- Cookbook — single editorial line ─────────── -->
  <section class="cookbook-line">
    <p class="section-label">Cookbook</p>
    <p class="cookbook-line__body">
      Option Greeks · AAD · Causal portfolios · Wrong-way risk
    </p>
    <a class="cookbook-line__link" href={`${base}cookbook/`}>
      Browse the cookbook
    </a>
  </section>

  <!-- Closing — restrained typographic ending ─── -->
  <section class="closing">
    <p class="closing__label">Open source</p>
    <a class="closing__url" href="https://github.com/lewismj/eta"
       target="_blank" rel="noopener noreferrer">
      github.com/lewismj/eta
    </a>
    <p class="closing__meta">
      Apache 2.0 licensed · <a href={`${base}docs/next-steps/`}>Roadmap</a>
    </p>
  </section>

  <Footer />
</BaseLayout>

