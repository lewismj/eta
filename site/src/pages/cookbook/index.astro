---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Card from "../../components/Card.astro";
import "../../styles/global.css";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");

const cookbooks = [
  {
    title: "Basics",
    body: "Hello world. Functions. Higher-order. Recursion. Args. Composition. Exceptions.",
    href: `${base}docs/cookbook/basics/`,
  },
  {
    title: "Numerics",
    body: "European options. SABR. XVA. Portfolio LP. AAD. Fact-tables.",
    href: `${base}docs/cookbook/numerics/`,
  },
  {
    title: "Logic",
    body: "N-queens. Send+more=money. Boolean simplifier. Symbolic diff. Unification.",
    href: `${base}docs/cookbook/logic/`,
  },
  {
    title: "Causal",
    body: "DAGs. do-calculus. Counterfactual estimation.",
    href: `${base}docs/cookbook/causal/`,
  },
  {
    title: "Concurrency",
    body: "Worker pools. Monte Carlo. Scatter-gather. Pub/sub. Distributed compute.",
    href: `${base}docs/cookbook/concurrency/`,
  },
  {
    title: "ML / Torch",
    body: "libtorch examples via the eta-torch package.",
    href: `${base}docs/cookbook/ml/`,
  },
];
---

<BaseLayout title="Cookbook" description="Practical Eta examples for quant, logic, causal, concurrency, and ML.">
  <Header />

  <!-- Page hero — quiet, matches homepage cadence -->
  <section class="page-hero">
    <p class="section-label">Cookbook</p>
    <h1 class="page-hero__title">Examples.</h1>
  </section>

  <!-- 2×3 grid using the same object-card treatment as the homepage -->
  <section class="section" style="padding-top: 0;">
    <div class="card-grid card-grid--3col">
      {cookbooks.map((c) => (
        <Card title={c.title} body={c.body} href={c.href} />
      ))}
    </div>
  </section>

  <!-- Closing pointer to the source -->
  <section class="closing">
    <p class="closing__label">Source</p>
    <a class="closing__url" href="https://github.com/lewismj/eta/tree/main/cookbook"
       target="_blank" rel="noopener noreferrer">
      github.com/lewismj/eta/tree/main/cookbook
    </a>
  </section>

  <Footer />
</BaseLayout>

