---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Card from "../../components/Card.astro";
import CardGrid from "../../components/CardGrid.astro";
import "../../styles/global.css";

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");

const cookbooks = [
  {
    title: "Basics",
    body: "Hello world, functions, higher-order functions, recursion, args, composition, and exceptions.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/basics",
  },
  {
    title: "Quant",
    body: "European options, SABR calibration, XVA, portfolio LP, AAD, and fact-table analytics.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/quant",
  },
  {
    title: "Logic",
    body: "N-queens, SEND+MORE=MONEY, boolean simplifier, symbolic diff, unification.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/logic",
  },
  {
    title: "Causal",
    body: "DAGs, do-calculus rules, and counterfactual estimation.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/causal",
  },
  {
    title: "Concurrency",
    body: "Worker pools, Monte Carlo, scatter-gather, pub/sub, and distributed compute.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/concurrency",
  },
  {
    title: "ML / Torch",
    body: "LibTorch examples via the eta-torch-sidecar package.",
    href: "https://github.com/lewismj/eta/tree/main/cookbook/ml",
  },
];
---

<BaseLayout title="Cookbook" description="Practical Eta examples for quant, logic, causal, concurrency, and ML.">
  <Header />
  <div style="max-width: 1120px; margin: 0 auto; padding: 56px 24px 0;">
    <p class="section-label">Cookbook</p>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem,6vw,4.5rem); font-weight:800; letter-spacing:-0.04em; line-height:1; margin-bottom:16px;">
      Learn by example.
    </h1>
    <p style="color: var(--muted); font-size:1.1rem; max-width:600px; margin-bottom:0;">
      Practical Eta programs covering quant workflows, logic programming,
      causal inference, concurrent messaging, and ML.
    </p>
  </div>
  <CardGrid>
    {cookbooks.map((c) => (
      <Card title={c.title} body={c.body} href={c.href} />
    ))}
  </CardGrid>
  <Footer />
</BaseLayout>

