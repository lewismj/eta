---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Eta",
  description = "A Lisp-like language for programmable systems, quant workflows, package-managed modules, and native sidecars.",
} = Astro.props;

const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title === "Eta" ? "Eta" : `${title} — Eta`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- Preload the D-DIN faces actually used above the fold so the
         hero never paints in a fallback. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={`${base}fonts/D-DIN.woff2`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={`${base}fonts/D-DIN-Bold.woff2`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={`${base}fonts/D-DINCondensed-Bold.woff2`} />
    <!-- D-DIN self-hosted — OFL-1.1 licence, source: github.com/amcchord/datto-d-din -->
    <Fragment set:html={`<style>
      @font-face { font-family: "D-DIN";          src: url("${base}fonts/D-DIN.woff2")               format("woff2"); font-weight: 400;     font-style: normal;  font-display: block; }
      @font-face { font-family: "D-DIN";          src: url("${base}fonts/D-DIN-Bold.woff2")           format("woff2"); font-weight: 700 900; font-style: normal;  font-display: block; }
      @font-face { font-family: "D-DIN";          src: url("${base}fonts/D-DIN-Italic.woff2")         format("woff2"); font-weight: 400;     font-style: italic;  font-display: block; }
      @font-face { font-family: "D-DINCondensed"; src: url("${base}fonts/D-DINCondensed.woff2")       format("woff2"); font-weight: 100 600; font-style: normal;  font-display: block; }
      @font-face { font-family: "D-DINCondensed"; src: url("${base}fonts/D-DINCondensed-Bold.woff2")  format("woff2"); font-weight: 700 900; font-style: normal;  font-display: block; }
      @font-face { font-family: "D-DINExp";       src: url("${base}fonts/D-DINExp.woff2")             format("woff2"); font-weight: 400;     font-style: normal;  font-display: swap; }
      @font-face { font-family: "D-DINExp";       src: url("${base}fonts/D-DINExp-Bold.woff2")        format("woff2"); font-weight: 700 900; font-style: normal;  font-display: swap; }
      @font-face { font-family: "D-DINExp";       src: url("${base}fonts/D-DINExp-Italic.woff2")      format("woff2"); font-weight: 400;     font-style: italic;  font-display: swap; }
    </style>`} />
  </head>
  <body>
    <slot />
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({
        startOnLoad: true,
        theme: "base",
        themeVariables: {
          background:          "#f5f5f4",
          mainBkg:             "#ffffff",
          nodeBorder:          "#fb8aa7",
          clusterBkg:          "#f5f5f4",
          clusterBorder:       "#d8d6d1",
          titleColor:          "#000000",
          nodeTextColor:       "#000000",
          edgeLabelBackground: "#f5f5f4",
          primaryColor:        "#ffffff",
          primaryTextColor:    "#000000",
          primaryBorderColor:  "#fb8aa7",
          secondaryColor:      "#f0eeec",
          tertiaryColor:       "#ece8e4",
          lineColor:           "#707070",
          fontFamily:          '"JetBrains Mono", ui-monospace, monospace',
          fontSize:            "13px",
        },
      });
    </script>
  </body>
</html>

