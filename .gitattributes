*.ipynb -linguist-detectable

# Linter fixtures encode exact byte spans and fixed-source output, so their
# line endings must stay LF on every platform.
eta/qa/test/fixtures/linter/*.eta text eol=lf
eta/qa/test/fixtures/linter/*.json text eol=lf


# Fuzz seeds and dictionaries are byte-exact (CRLF framing headers, binary .etac
# and wire-format frames); never let git convert them.
eta/qa/fuzz/samples/** -text
eta/qa/fuzz/dict/** -text
