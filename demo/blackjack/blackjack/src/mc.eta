    (defun debug-worker-round-stand-latency ()
      (let* ((me (self))
             (cfg (make-mc-shoe 42))
             (per-rank (* 4 (mc-shoe-decks cfg)))
             (total (%total-cards (mc-shoe-decks cfg)))
             (t0 (time:monotonic-ms))
             (_w (spawn
                   (lambda ()
                     (let* ((shoe (%fresh-compact-shoe cfg 1))
                            (player-hand (vector 0 0 0))
                            (dealer-hand (vector 0 0 0))
                            (_row (%simulate-round!
                                    (lambda (player-total dealer-up player-soft count) 'stand)
                                    cfg
                                    0
                                    42
                                    shoe
                                    per-rank
                                    total
                                    player-hand
                                    dealer-hand)))
                       (send/checked me '(mc-round-stand-ping))))))
             (msg (receive-match
                    (lambda (m)
                      (and (pair? m)
                           (eq? (car m) 'mc-round-stand-ping)))
                    180000
                    (lambda () #f)))
             (t1 (time:monotonic-ms)))
        (if msg
            (time:elapsed-ms t0 t1)
            -1)))

    (defun debug-local-round-stand-latency ()
      (let* ((cfg (make-mc-shoe 42))
             (shoe (%fresh-compact-shoe cfg 1))
             (per-rank (* 4 (mc-shoe-decks cfg)))
             (total (%total-cards (mc-shoe-decks cfg)))
             (player-hand (vector 0 0 0))
             (dealer-hand (vector 0 0 0))
             (t0 (time:monotonic-ms))
             (_row (%simulate-round!
                     (lambda (player-total dealer-up player-soft count) 'stand)
                     cfg
                     0
                     42
                     shoe
                     per-rank
                     total
                     player-hand
                     dealer-hand))
             (t1 (time:monotonic-ms)))
        (time:elapsed-ms t0 t1)))

    (defun replay-deterministic (policy cfg n . rest)
      (let* ((workers (if (null? rest) default-mc-workers (car rest)))
             (rows-a (simulate policy cfg n workers))
             (rows-b (simulate policy cfg n workers))
             (summary-a (simulate-summary rows-a))
             (summary-b (simulate-summary rows-b))
             (trace-match (equal? rows-a rows-b))
             (summary-match (equal? summary-a summary-b)))
        (list
          (cons 'trace-match trace-match)
          (cons 'summary-match summary-match)
          (cons 'match (and trace-match summary-match))
          (cons 'rounds n)
          (cons 'workers workers))))

    (defun replay-worker-parity (policy cfg n workers-a workers-b)
      (let* ((profile-a (simulate-summary-only policy cfg n workers-a))
             (profile-b (simulate-summary-only policy cfg n workers-b))
             (summary-a (%alist-get 'summary profile-a))
             (summary-b (%alist-get 'summary profile-b)))
        (list
          (cons 'workers-a workers-a)
          (cons 'workers-b workers-b)
          (cons 'summary-a summary-a)
          (cons 'summary-b summary-b)
          (cons 'match (equal? summary-a summary-b)))))

  )
