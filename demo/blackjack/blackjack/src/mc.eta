                    (lambda (m)
                      (and (pair? m)
                           (eq? (car m) 'mc-draw-ping)))
                    180000
                    (lambda () #f)))
             (t1 (time:monotonic-ms)))
        (if msg
            (time:elapsed-ms t0 t1)
            -1)))

