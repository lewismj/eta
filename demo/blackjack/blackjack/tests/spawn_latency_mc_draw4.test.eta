(module blackjack.tests.spawn_latency_mc_draw4
  (import std.test mc)
  (begin

    (define suite
      (make-group "spawn latency mc draw4"
        (list
          (make-test "spawn closure draws four cards"
            (lambda ()
              (let ((worker-latency (debug-worker-draw4-latency))
                    (local-latency (debug-local-draw4-latency)))
                (if (= worker-latency -1)
                    (error "mc draw4 ping timed out")
                    (if (> worker-latency 5000)
                        (error (string-append
                                 "mc draw4 worker-latency-ms="
                                 (number->string worker-latency)
                                 ", local-latency-ms="
                                 (number->string local-latency)))
                        (assert-true #t)))))))))

    (print-tap (run suite))))
