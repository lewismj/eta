;;; stdlib/tests/math.test.eta — Unit tests for std.math

;; eta-lint:disable-file=ETA501
(module math.tests
  (import std.test std.math)
  (begin

    ;;@doc (suite)
    ;;@category Tests
    ;;@module math.tests
    ;; Unit tests for std.math Uses `suite`.
    ;;@example
    ;; (display suite)
    (define
      suite
      (make-group
        "std.math"
        (list

          ;; ── Constants ────────────────────────────────────────────
          (make-group
            "constants"
            (list
              (make-test
                "pi is approximately 3.14159"
                (lambda () (assert-approx-equal 3.14159 pi 0.001)))
              (make-test
                "e is approximately 2.71828"
                (lambda () (assert-approx-equal 2.71828 e 0.001)))))

          ;; ── Basic helpers ─────────────────────────────────────────
          (make-group
            "helpers"
            (list
              (make-test "square" (lambda () (assert-equal 9 (square 3))))
              (make-test "cube" (lambda () (assert-equal 27 (cube 3))))
              (make-test "even? true" (lambda () (assert-true (even? 4))))
              (make-test "even? false" (lambda () (assert-false (even? 3))))
              (make-test "odd? true" (lambda () (assert-true (odd? 3))))
              (make-test "odd? false" (lambda () (assert-false (odd? 4))))
              (make-test "sign positive" (lambda () (assert-equal 1 (sign 5))))
              (make-test "sign negative" (lambda () (assert-equal -1 (sign -5))))
              (make-test "sign zero" (lambda () (assert-equal 0 (sign 0))))
              (make-test "clamp below" (lambda () (assert-equal 0 (clamp -5 0 10))))
              (make-test "clamp above" (lambda () (assert-equal 10 (clamp 15 0 10))))
              (make-test "clamp within" (lambda () (assert-equal 5 (clamp 5 0 10))))))

          ;; ── Integer functions ─────────────────────────────────────
          (make-group
            "integer"
            (list
              (make-test "quotient" (lambda () (assert-equal 3 (quotient 10 3))))
              (make-test "gcd" (lambda () (assert-equal 6 (gcd 12 18))))
              (make-test "lcm" (lambda () (assert-equal 36 (lcm 12 18))))))

          ;; ── Rounding ─────────────────────────────────────────────
          (make-group
            "rounding"
            (list
              ;; flonum in, flonum out (equal? distinguishes 3 from 3.0)
              (make-test "floor" (lambda () (assert-equal 3.0 (floor 3.7))))
              (make-test "ceiling" (lambda () (assert-equal 4.0 (ceiling 3.2))))
              (make-test "round up" (lambda () (assert-equal 4.0 (round 3.5))))
              (make-test "truncate" (lambda () (assert-equal 3.0 (truncate 3.9))))
              ;; IEEE roundTiesToEven
              (make-test "round tie to even down" (lambda () (assert-equal 2.0 (round 2.5))))
              (make-test "round tie to even negative" (lambda () (assert-equal -2.0 (round -2.5))))
              (make-test "round half" (lambda () (assert-equal 0.0 (round 0.5))))
              (make-test "round exact integer" (lambda () (assert-equal 7 (round 7))))
              ;; negative inputs depend on modulo being floored; flonum in, flonum out
              (make-test "floor negative" (lambda () (assert-equal -3.0 (floor -2.5))))
              (make-test "floor negative near integer" (lambda () (assert-equal -1.0 (floor -0.25))))
              (make-test "ceiling negative" (lambda () (assert-equal -2.0 (ceiling -2.5))))
              (make-test "truncate negative" (lambda () (assert-equal -2.0 (truncate -2.5))))
              (make-test "round negative" (lambda () (assert-equal -3.0 (round -3.2))))
              (make-test "floor exact integer" (lambda () (assert-equal -4 (floor -4))))
              (make-test "quotient negative" (lambda () (assert-equal -3.0 (quotient -7 2))))))

          ;; ── modulo / remainder ───────────────────────────────────
          (make-group
            "modulo-remainder"
            (list
              (make-test "modulo takes divisor sign" (lambda () (assert-equal 2 (modulo -7 3))))
              (make-test "remainder takes dividend sign" (lambda () (assert-equal -1 (remainder -7 3))))
              (make-test "modulo flonum floored" (lambda () (assert-equal 0.5 (modulo -7.5 2))))
              (make-test "remainder flonum truncated" (lambda () (assert-equal 2.0 (remainder 5.0 3.0))))
              (make-test "gcd negative" (lambda () (assert-equal 6 (gcd -12 18))))))

          ;; ── Exponentiation ───────────────────────────────────────
          (make-group
            "expt"
            (list
              (make-test "expt 2^3" (lambda () (assert-equal 8 (expt 2 3))))
              (make-test "expt 2^0" (lambda () (assert-equal 1 (expt 2 0))))
              (make-test "expt 5^2" (lambda () (assert-equal 25 (expt 5 2))))))

          ;; ── sum / product ─────────────────────────────────────────
          (make-group
            "sum-product"
            (list
              (make-test "sum" (lambda () (assert-equal 15 (sum '(1 2 3 4 5)))))
              (make-test "sum empty" (lambda () (assert-equal 0 (sum '()))))
              (make-test "product" (lambda () (assert-equal 120 (product '(1 2 3 4 5)))))
              (make-test "product empty" (lambda () (assert-equal 1 (product '()))))))))
      (print-tap (run suite)))))
