;;; stdlib/tests/actor_node.test.eta - Unit tests for std.actor.node.

(module actor_node.tests
  (import std.test std.actor.node)
  (begin

    (define suite
      (make-group "std.actor.node"
        (list

          (make-test "node-name returns string"
            (lambda ()
              (assert-true (string? (node-name)))))

          (make-test "nodes returns a list"
            (lambda ()
              (let ((connected (nodes)))
                (assert-true (or (null? connected)
                                 (pair? connected))))))

          )))

    (print-tap (run suite))))
