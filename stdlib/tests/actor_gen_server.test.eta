;;; stdlib/tests/actor_gen_server.test.eta - Unit tests for std.actor.gen_server.

(module actor_gen_server.tests
  (import std.test std.actor std.actor.gen_server)
  (begin

    (defun make-counter-module (parent)
      (list
        (cons 'init
              (lambda (initial)
                (list 'ok initial)))
        (cons 'handle-call
              (lambda (request from state)
                (cond
                  ((eq? request 'get)
                   (list 'reply state state))
                  ((eq? request 'get-caller)
                   (list 'reply from state))
                  ((eq? request 'block)
                   (list 'noreply state))
                  ((and (pair? request)
                        (eq? (car request) 'add)
                        (pair? (cdr request))
                        (null? (cdr (cdr request))))
                   (let ((next (+ state (car (cdr request)))))
                     (list 'reply next next)))
                  (else
                   (list 'reply 'unknown state)))))
        (cons 'handle-cast
              (lambda (message state)
                (if (and (pair? message)
                         (eq? (car message) 'inc)
                         (pair? (cdr message))
                         (null? (cdr (cdr message))))
                    (list 'noreply (+ state (car (cdr message))))
                    (list 'noreply state))))
        (cons 'terminate
              (lambda (reason state)
                (send parent (list 'terminated reason state))
                'ok))))

    (defun make-basic-module ()
      (list
        (cons 'init
              (lambda (initial)
                (list 'ok initial)))
        (cons 'handle-call
              (lambda (request from state)
                (cond
                  ((eq? request 'get)
                   (list 'reply state state))
                  (else
                   (list 'reply request state)))))
        (cons 'handle-cast
              (lambda (message state)
                (list 'noreply state)))))

    (define suite
      (make-group "std.actor.gen_server"
        (list

          (make-test "call and cast update state and stop runs terminate callback"
            (lambda ()
              (let* ((parent (self))
                     (server (gen-server-start (make-counter-module parent) 10 '())))
                (assert-true (pid? server))
                (assert-equal 10 (gen-server-call server 'get 1000))
                (assert-equal 'ok (gen-server-cast server '(inc 5)))
                (assert-equal 15 (gen-server-call server 'get 1000))
                (assert-equal 17 (gen-server-call server '(add 2) 1000))
                (let ((caller (gen-server-call server 'get-caller 1000)))
                  (assert-true (pid? caller)))
                (assert-equal 'ok (gen-server-stop server 'shutdown 1000))
                (let ((term (receive-after 1000)))
                  (assert-true (pair? term))
                  (assert-equal 'terminated (car term))
                  (assert-equal 'shutdown (car (cdr term)))
                  (assert-equal 17 (car (cdr (cdr term))))
                  (assert-false (alive? server))))))

          (make-test "start-link emits EXIT when trap-exit is enabled"
            (lambda ()
              (trap-exit! #t)
              (let ((server (gen-server-start-link (make-basic-module) 1 '())))
                (assert-true (pid? server))
                (let* ((stop-result (gen-server-stop server 'shutdown 1000))
                       (exit-msg
                         (receive
                           (list
                             (match-case (match-list 'EXIT 2)
                                         (lambda (msg) msg)))
                           1000
                           (lambda () #f))))
                  (trap-exit! #f)
                  (assert-equal 'ok stop-result)
                  (assert-true (pair? exit-msg))
                  (assert-equal 'EXIT (car exit-msg))
                  (assert-true (pid? (car (cdr exit-msg))))
                  (assert-equal 'shutdown (car (cdr (cdr exit-msg))))
                  (assert-false (alive? server))))))

          (make-test "call timeout returns false when server returns noreply"
            (lambda ()
              (let* ((parent (self))
                     (server (gen-server-start (make-counter-module parent) 0 '())))
                (assert-true (pid? server))
                (assert-equal #f (gen-server-call server 'block 20))
                (assert-equal 'ok (gen-server-stop server 'shutdown 1000))
                (assert-true (pair? (receive-after 1000)))
                (assert-false (alive? server)))))

          (make-test "name option allows call and stop by registered symbol"
            (lambda ()
              (assert-equal #f (whereis 'gen-server-test-name))
              (let ((server
                      (gen-server-start (make-basic-module) 3 '(name gen-server-test-name))))
                (assert-true (pid? server))
                (assert-true (pid? (whereis 'gen-server-test-name)))
                (assert-equal 3 (gen-server-call 'gen-server-test-name 'get 1000))
                (assert-equal 'ok (gen-server-stop 'gen-server-test-name 'shutdown 1000))
                (assert-equal #f (whereis 'gen-server-test-name))
                (assert-false (alive? server)))))

          )))

    (print-tap (run suite))))
