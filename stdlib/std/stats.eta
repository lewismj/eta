    ;;@doc (stats:quantile-vec a b . rest)
    ;;@category Stats
    ;;@module std.stats
    ;;@example
    ;; (stats:quantile-vec 1 1 '())
    ;; Column-wise quantiles:
    ;;   (stats:quantile-vec (list seq1 seq2) p)
    ;;   (stats:quantile-vec fact-table '(col1 col2) p)
    (defun stats:quantile-vec (a b . rest)
      (if (null? rest)
          (%stats-quantile-vec a b)
          (%stats-quantile-vec a b (car rest))))

    ;;@doc (stats:ols-multi a b . rest)
    ;;@category Stats
    ;;@module std.stats
    ;;@example
    ;; (stats:ols-multi 1 1 '())
    ;; Multivariate OLS:
    ;;   (stats:ols-multi y-seq (list x1 x2))
    ;;   (stats:ols-multi fact-table y-col '(x1-col x2-col))
    (defun stats:ols-multi (a b . rest)
      (if (null? rest)
          (%stats-ols-multi a b)
          (%stats-ols-multi a b (car rest))))

    ;;@doc (%stats:assoc-value alist sym-key str-key)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `%stats:assoc-value`.
    ;;@example
    ;; (%stats:assoc-value 'x 'x 'x)
    (defun %stats:assoc-value (alist sym-key str-key)
      (let ((sp (assoc sym-key alist)))
        (if sp
            (cdr sp)
            (let ((tp (assoc str-key alist)))
              (if tp (cdr tp) #f)))))

    ;;@doc (%stats:pair-cdr-at alist idx)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `%stats:pair-cdr-at`.
    ;;@example
    ;; (%stats:pair-cdr-at 'x 1)
    (defun %stats:pair-cdr-at (alist idx)
      (if (or (< idx 0) (>= idx (length alist)))
          #f
          (let ((entry (list-ref alist idx)))
            (if (pair? entry) (cdr entry) #f))))

    ;;@doc (stats:ols-multi-coefficients r)
    ;;@category Stats
    ;;@module std.stats
    ;;@example
    ;; (stats:ols-multi-coefficients 'x)
    ;;  OLS-multi accessors (result is an alist) 
    (defun stats:ols-multi-coefficients (r)
      (or (%stats:assoc-value r 'coefficients "coefficients")
          (%stats:pair-cdr-at r 0)))
    ;;@doc (stats:ols-multi-std-errors r)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:ols-multi-std-errors`.
    ;;@example
    ;; (stats:ols-multi-std-errors 'x)
    (defun stats:ols-multi-std-errors (r)
      (or (%stats:assoc-value r 'std-errors "std-errors")
          (%stats:pair-cdr-at r 1)))
    ;;@doc (stats:ols-multi-t-stats r)
    ;;@category Stats
