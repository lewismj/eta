    (defun stats:ols-multi-t-stats (r)
      (or (%stats:assoc-value r 't-stats "t-stats")
          (%stats:pair-cdr-at r 2)))
    ;;@doc (stats:ols-multi-p-values r)
    ;;@category Stats
