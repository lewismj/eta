    ;;  Multivariate / column-wise operations 
    ;; All accept either:
    ;;   (fn (list seq1 seq2 ...))           list of numeric sequences
    ;;   (fn fact-table '(col1 col2 ...))    fact-table + column indices

    ;;@doc (stats:mean-vec data . rest)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:mean-vec`.
    ;;@example
    ;; (stats:mean-vec 'x '())
    (defun stats:mean-vec (data . rest)
      (if (null? rest)
          (%stats-mean-vec data)
          (%stats-mean-vec data (car rest))))

    ;;@doc (stats:var-vec data . rest)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:var-vec`.
    ;;@example
    ;; (stats:var-vec 'x '())
    (defun stats:var-vec (data . rest)
      (if (null? rest)
          (%stats-var-vec data)
          (%stats-var-vec data (car rest))))

    ;;@doc (stats:cov-matrix data . rest)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:cov-matrix`.
    ;;@example
    ;; (stats:cov-matrix 'x '())
    (defun stats:cov-matrix (data . rest)
      (if (null? rest)
          (%stats-cov-matrix data)
          (%stats-cov-matrix data (car rest))))

    ;;@doc (stats:cor-matrix data . rest)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:cor-matrix`.
    ;;@example
    ;; (stats:cor-matrix 'x '())
    (defun stats:cor-matrix (data . rest)
