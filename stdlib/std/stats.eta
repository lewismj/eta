    ;;@doc (stats:ols-multi-residual-se r)
    ;;@category Stats
    ;;@module std.stats
    ;; Compute `stats:ols-multi-residual-se`.
    ;;@example
    ;; (stats:ols-multi-residual-se 'x)
    (defun stats:ols-multi-residual-se (r)
