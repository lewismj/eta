;;; std/test.eta  Lightweight test framework.
;;;
;;; Usage:
;;;   (import std.test)
;;;   (define results
;;;     (run (make-group "my suite"
;;;       (list
;;;         (make-test "addition" (lambda () (assert-equal 4 (+ 2 2))))
;;;         (make-test "truthy"  (lambda () (assert-true #t)))))))
;;;   (print-summary (summary results))
;;;
;;; TAP output:
;;;   (print-tap results)    ; emits TAP 13 to stdout
;;;
;;; JUnit XML output:
;;;   (print-junit results)  ; emits JUnit XML to stdout

(module std.test
  (import std.core)
  (export
    ;; Constructors
    make-test make-group
    ;; Runner
    run summary
    ;; Summary accessors
    summary-total summary-passed summary-failed
    ;; Assertions
    assert-true assert-false assert-equal assert-not-equal
    assert-approx-equal
    ;; Output
    print-summary print-tap print-junit)
  (begin

    ;;  Data (tagged vectors via define-record-type) 

    (define-record-type test-case
      (make-test name thunk)
      test-case?
      (name test-name)
      (thunk test-thunk))

    (define-record-type test-group
      (make-group name children)
      test-group?
      (name group-name)
      (children group-children))

    (define-record-type test-result
      (%make-result name status error)
      test-result?
      (name result-name)
      (status result-status)
      (error result-error))

    (define-record-type group-result
      (%make-group-result name status children)
      group-result?
      (name gresult-name)
      (status gresult-status)
      (children gresult-children))

    (define-record-type test-summary
      (%make-summary total passed failed)
      test-summary?
      (total summary-total)
      (passed summary-passed)
      (failed summary-failed))

    ;;  Local helpers (no imports needed) 

    ;;@doc (%map f xs)
    ;;@category Helpers
    ;;@module std.test
    ;; Apply `f` to each element of `xs` and return the mapped list.
    ;;@example
    ;; (%map (lambda (x) (+ x 1)) '(1 2 3))
    (defun %map (f xs)
      (if (null? xs)
          '()
          (cons (f (car xs)) (%map f (cdr xs)))))

    ;;@doc (%foldl f acc xs)
    ;;@category Helpers
    ;;@module std.test
    ;; Left-fold `xs` using reducer `f` and initial accumulator `acc`.
    ;;@example
    ;; (%foldl (lambda (acc x) (+ acc x)) 0 '(1 2 3))
    (defun %foldl (f acc xs)
      (if (null? xs)
          acc
          (%foldl f (f acc (car xs)) (cdr xs))))

    ;;  Assertions 

    ;;@doc (assert-true x . rest)
    ;;@category Assertions
    ;;@module std.test
    ;; Pass when `x` is truthy; otherwise raise an assertion error.
    ;;@example
    ;; (assert-true (> 3 1))
    (defun assert-true (x . rest)
      (let ((msg (if (null? rest) "expected true" (car rest))))
        (if x 'ok (error msg))))

    ;;@doc (assert-false x . rest)
    ;;@category Assertions
    ;;@module std.test
    ;; Pass when `x` is falsey; otherwise raise an assertion error.
    ;;@example
    ;; (assert-false (= 1 2))
    (defun assert-false (x . rest)
      (let ((msg (if (null? rest) "expected false" (car rest))))
        (if x (error msg) 'ok)))

    ;;@doc (%val->string x)
    ;;@category Helpers
    ;;@module std.test
    ;; Render `x` to a string using `display`.
    ;;@example
    ;; (%val->string 1)
    (defun %val->string (x)
      (let ((p (open-output-string)))
        (display x p)
        (get-output-string p)))

    ;;@doc (assert-equal expected actual . rest)
    ;;@category Assertions
    ;;@module std.test
    ;; Assert that `expected` and `actual` are equal under `equal?`.
    ;;@example
    ;; (assert-equal 4 (+ 2 2))
    (defun assert-equal (expected actual . rest)
      (let ((msg (if (null? rest)
                     (string-append "expected "
                       (%val->string expected)
                       " but got "
                       (%val->string actual))
                     (car rest))))
        (if (equal? expected actual)
            'ok
            (error msg))))

    ;;@doc (assert-not-equal a b . rest)
    ;;@category Assertions
    ;;@module std.test
    ;; Assert that `a` and `b` are not equal under `equal?`.
    ;;@example
    ;; (assert-not-equal 1 2)
    (defun assert-not-equal (a b . rest)
      (let ((msg (if (null? rest) "expected values to differ" (car rest))))
        (if (equal? a b) (error msg) 'ok)))

    ;;@doc (assert-approx-equal expected actual . rest)
    ;;@category Assertions
    ;;@module std.test
    ;; Assert that two numbers differ by at most `tol` (default `1e-9`).
    ;;@example
    ;; (assert-approx-equal 3.14 3.1400000001)
    (defun assert-approx-equal (expected actual . rest)
      (let ((tol (if (null? rest) 1e-9 (car rest))))
        (let ((diff (if (> expected actual)
                        (- expected actual)
                        (- actual expected))))
          (if (> diff tol)
              (error (string-append "expected approx "
                       (%val->string expected)
                       " but got "
                       (%val->string actual)
                       " (diff="
                       (%val->string diff)
                       ")"))
              'ok))))

    ;;  Runner 

    ;;@doc (%run-test t)
    ;;@category Runner
    ;;@module std.test
    ;; Execute one test case and return a `test-result` with status `'pass`.
    ;;@example
    ;; (%run-test (make-test "ok" (lambda () (assert-true #t))))
    (defun %run-test (t)
      ;; Execute the thunk; on success return pass, on error return fail.
      ;; NOTE: Until try/catch exists, a failing assertion (error) will
      ;; propagate up. For now, tests either all pass or abort on first failure.
      (begin
        ((test-thunk t))
        (%make-result (test-name t) 'pass '())))

    ;;@doc (%all-pass? rs)
    ;;@category Runner
    ;;@module std.test
    ;; Return `#t` when every result in `rs` has status `'pass`.
    ;;@example
    ;; (%all-pass? '())
    (defun %all-pass? (rs)
      (if (null? rs)
          #t
          (let ((st (if (test-result? (car rs))
                        (result-status (car rs))
                        (gresult-status (car rs)))))
            (if (eq? st 'pass)
                (%all-pass? (cdr rs))
                #f))))

    ;;@doc (%run-group g)
    ;;@category Runner
    ;;@module std.test
    ;; Run all children in group `g` and compute the group pass/fail status.
    ;;@example
    ;; (%run-group (make-group "g" (list (make-test "ok" (lambda () (assert-true #t))))))
    (defun %run-group (g)
      (let ((kids (%map run (group-children g))))
        (let ((status (if (%all-pass? kids) 'pass 'fail)))
          (%make-group-result (group-name g) status kids))))

    ;;@doc (run node)
    ;;@category Runner
    ;;@module std.test
    ;; Run a test node (`test-case` or `test-group`) and return a result tree.
    ;;@example
    ;; (run (make-test "ok" (lambda () (assert-true #t))))
    (defun run (node)
      (if (test-case? node)
          (%run-test node)
          (%run-group node)))

    ;;  Summary 

    ;;@doc (%add-summary a b)
    ;;@category Summary
    ;;@module std.test
    ;; Merge two `test-summary` values by summing totals, passes, and failures.
    ;;@example
    ;; (%add-summary (%make-summary 1 1 0) (%make-summary 2 1 1))
    (defun %add-summary (a b)
      (%make-summary
        (+ (summary-total a)  (summary-total b))
        (+ (summary-passed a) (summary-passed b))
        (+ (summary-failed a) (summary-failed b))))

    ;;@doc (%count-results res)
    ;;@category Summary
    ;;@module std.test
    ;; Count total/passed/failed tests represented by one result-tree node.
    ;;@example
    ;; (%count-results (run (make-test "ok" (lambda () (assert-true #t)))))
    (defun %count-results (res)
      (if (test-result? res)
          (if (eq? (result-status res) 'pass)
              (%make-summary 1 1 0)
              (%make-summary 1 0 1))
          ;; group result  fold children
          (%foldl %add-summary
                   (%make-summary 0 0 0)
                   (%map %count-results (gresult-children res)))))

    ;;@doc (summary res)
    ;;@category Summary
    ;;@module std.test
    ;; Build a `test-summary` for the result tree returned by `(run ...)`.
    ;;@example
    ;; (summary (run (make-test "ok" (lambda () (assert-true #t)))))
    (defun summary (res)
      (%count-results res))

    ;;@doc (print-summary s)
    ;;@category Summary
    ;;@module std.test
    ;; Print a human-readable summary line.
    ;;@example
    ;; (print-summary (summary (run (make-test "ok" (lambda () (assert-true #t))))))
    (defun print-summary (s)
      (display (summary-total s))
      (display " tests, ")
      (display (summary-passed s))
      (display " passed, ")
      (display (summary-failed s))
      (display " failed")
      (newline))

    ;;  TAP 13 output 
    ;;
    ;; Emits TAP version 13 format that can be consumed by VS Code
    ;; Test Explorer (via a TAP parser) and IntelliJ (via tap-junit).
    ;;
    ;; Format:
    ;;   TAP version 13
    ;;   1..N
    ;;   ok 1 - test name
    ;;   not ok 2 - test name
    ;;     ---
    ;;     message: error message
    ;;     ...

    ;;@doc (%tap-collect-results res acc)
    ;;@category Output
    ;;@module std.test
    ;; Flatten nested group results into a linear list of test results.
    ;;@example
    ;; (%tap-collect-results (run (make-test "ok" (lambda () (assert-true #t)))) '())
    (defun %tap-collect-results (res acc)
      ;; Flatten all test-results from nested group-results into a list.
      (if (test-result? res)
          (cons res acc)
          ;; group result  recurse children
          (%foldl (lambda (a child) (%tap-collect-results child a))
                   acc
                   (gresult-children res))))

    ;;@doc (%tap-print-result idx r)
    ;;@category Output
    ;;@module std.test
    ;; Emit TAP output for one test result at sequence number `idx`.
    ;;@example
    ;; (%tap-print-result 1 (%make-result "ok" 'pass '()))
    (defun %tap-print-result (idx r)
      (if (eq? (result-status r) 'pass)
          (begin
            (display "ok ")
            (display idx)
            (display " - ")
            (display (result-name r))
            (newline))
          (begin
            (display "not ok ")
            (display idx)
            (display " - ")
            (display (result-name r))
            (newline)
            (display "  ---")
            (newline)
            (display "  message: ")
            (display (result-error r))
            (newline)
            (display "  ...")
            (newline))))

    ;;@doc (%tap-print-all results idx)
    ;;@category Output
    ;;@module std.test
    ;; Emit TAP lines for each result in `results`, starting at index `idx`.
    ;;@example
    ;; (%tap-print-all (list (%make-result "ok" 'pass '())) 1)
    (defun %tap-print-all (results idx)
      (if (null? results)
          'done
          (begin
            (%tap-print-result idx (car results))
            (%tap-print-all (cdr results) (+ idx 1)))))

    ;;@doc (print-tap res)
    ;;@category Output
    ;;@module std.test
    ;; Emit TAP 13 output for a result tree produced by `(run ...)`.
    ;;@example
    ;; (define results (run suite))
    ;; (print-tap results)
    ;;@example
    ;; (print-tap (run (make-test "ok" (lambda () (assert-true #t)))))
    (defun print-tap (res)
      ;; res is the result of (run ...).
      (let ((flat (reverse (%tap-collect-results res '()))))
        (let ((n (length flat)))
          (display "TAP version 13")
          (newline)
          (display "1..")
          (display n)
          (newline)
          (%tap-print-all flat 1))))

    ;;  JUnit XML output 
    ;;
    ;; Emits JUnit XML that can be imported by IntelliJ / CI systems.

    ;;@doc (%xml-escape s)
    ;;@category Helpers
    ;;@module std.test
    ;; Escape XML-sensitive characters in `s` (`&`, `<`, `>`, and `\"`).
    ;;@example
    ;; (%xml-escape "<suite&case>")
    (defun %xml-escape (s)
      ;; Minimal XML escaping for attribute/text values.
      ;; Uses string-ref / string-length and eqv? to avoid char=? / string->list.
      (let ((p (open-output-string))
            (n (string-length s)))
        (let loop ((i 0))
          (if (= i n)
              (get-output-string p)
              (begin
                (let ((c (string-ref s i)))
                  (cond
                    ((eqv? c #\&)  (display "&amp;"  p))
                    ((eqv? c #\<)  (display "&lt;"   p))
                    ((eqv? c #\>)  (display "&gt;"   p))
                    ((eqv? c #\")  (display "&quot;" p))
                    (else          (display c p))))
                (loop (+ i 1)))))))

    ;;@doc (%junit-print-result r)
    ;;@category Output
    ;;@module std.test
    ;; Emit a JUnit `<testcase>` element for one test result.
    ;;@example
    ;; (%junit-print-result (%make-result "ok" 'pass '()))
    (defun %junit-print-result (r)
      (if (eq? (result-status r) 'pass)
          (begin
            (display "    <testcase name=\"")
            (display (%xml-escape (result-name r)))
            (display "\"/>")
            (newline))
          (begin
            (display "    <testcase name=\"")
            (display (%xml-escape (result-name r)))
            (display "\">")
            (newline)
            (display "      <failure message=\"")
            (display (%xml-escape (%val->string (result-error r))))
            (display "\"/>")
            (newline)
            (display "    </testcase>")
            (newline))))

    ;;@doc (%junit-print-all results)
    ;;@category Output
    ;;@module std.test
    ;; Emit JUnit `<testcase>` elements for every result in `results`.
    ;;@example
    ;; (%junit-print-all (list (%make-result "ok" 'pass '())))
    (defun %junit-print-all (results)
      (if (null? results)
          'done
          (begin
            (%junit-print-result (car results))
            (%junit-print-all (cdr results)))))

    ;;@doc (print-junit res . suite-name-rest)
    ;;@category Output
    ;;@module std.test
    ;; Emit JUnit XML for a result tree produced by `(run ...)`.
    ;;@example
    ;; (print-junit (run (make-test "ok" (lambda () (assert-true #t)))))
    (defun print-junit (res . suite-name-rest)
      (let ((suite-name (if (null? suite-name-rest) "eta-tests" (car suite-name-rest))))
        (let ((flat (reverse (%tap-collect-results res '()))))
          (let ((s (summary res)))
            (display "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
            (newline)
            (display "<testsuite name=\"")
            (display (%xml-escape suite-name))
            (display "\" tests=\"")
            (display (summary-total s))
            (display "\" failures=\"")
            (display (summary-failed s))
            (display "\">")
            (newline)
            (%junit-print-all flat)
            (display "</testsuite>")
            (newline)))))

  ))
