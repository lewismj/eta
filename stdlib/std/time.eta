;;; std/time.eta - Time utilities built on native %time-* primitives.
;;;
;;; Builtins already available:
;;;   %time-now-ms  %time-now-us  %time-now-ns
;;;   %time-monotonic-ms  %time-sleep-ms
;;;   %time-utc-parts  %time-local-parts
;;;   %time-format-iso8601-utc  %time-format-iso8601-local

(module std.time
  (export
    time:now-ms
    time:now-us
    time:now-ns
    time:monotonic-ms
    time:sleep-ms
    time:utc-parts
    time:local-parts
    time:format-iso8601-utc
    time:format-iso8601-local
    time:elapsed-ms)
  (begin

    ;;@doc (time:now-ms ...)
    ;;@category Time
    ;;@module std.time
    ;; Time utilities built on native %time-* primitives Uses `time:now-ms`.
    ;;@example
    ;; (time:now-ms)
    (defun time:now-ms () (%time-now-ms))
    ;;@doc (time:now-us)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:now-us`.
    ;;@example
    ;; (time:now-us)
    (defun time:now-us () (%time-now-us))
    ;;@doc (time:now-ns)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:now-ns`.
    ;;@example
    ;; (time:now-ns)
    (defun time:now-ns () (%time-now-ns))
    ;;@doc (time:monotonic-ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:monotonic-ms`.
    ;;@example
    ;; (time:monotonic-ms)
    (defun time:monotonic-ms () (%time-monotonic-ms))

    ;;@doc (time:sleep-ms ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:sleep-ms`.
    ;;@example
    ;; (time:sleep-ms 'x)
    (defun time:sleep-ms (ms)
      (%time-sleep-ms ms))

    ;;@doc (time:utc-parts epoch-ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:utc-parts`.
    ;;@example
    ;; (time:utc-parts 'x)
    (defun time:utc-parts (epoch-ms)
      (%time-utc-parts epoch-ms))

    ;;@doc (time:local-parts epoch-ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:local-parts`.
    ;;@example
    ;; (time:local-parts 'x)
    (defun time:local-parts (epoch-ms)
      (%time-local-parts epoch-ms))

    ;;@doc (time:format-iso8601-utc epoch-ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:format-iso8601-utc`.
    ;;@example
    ;; (time:format-iso8601-utc 'x)
    (defun time:format-iso8601-utc (epoch-ms)
      (%time-format-iso8601-utc epoch-ms))

    ;;@doc (time:format-iso8601-local epoch-ms)
    ;;@category Time
    ;;@module std.time
    ;; Compute `time:format-iso8601-local`.
    ;;@example
    ;; (time:format-iso8601-local 'x)
    (defun time:format-iso8601-local (epoch-ms)
      (%time-format-iso8601-local epoch-ms))

    ;;@doc (time:elapsed-ms start-monotonic end-monotonic)
    ;;@category Time
    ;;@module std.time
    ;;@example
    ;; (time:elapsed-ms 'x 'x)
    ;; Returns a non-negative monotonic delta in milliseconds.
    (defun time:elapsed-ms (start-monotonic end-monotonic)
      (let ((delta (- end-monotonic start-monotonic)))
        (if (< delta 0) 0 delta)))

  ))
