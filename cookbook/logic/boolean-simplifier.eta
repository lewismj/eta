;;; boolean-simplifier.eta — Symbolic boolean expression simplifier
;;;
;;; Demonstrates: recursive tree transformation, quoting, cond, pattern
;;; matching on S-expression trees, De Morgan's laws, fixed-point iteration.
;;;
;;; Expression language:
;;;   #t / #f         — boolean constants
;;;   symbol          — variable
;;;   (not e)         — negation
;;;   (and e1 e2)     — conjunction
;;;   (or  e1 e2)     — disjunction
;;;
;;; Run:  etai cookbook/logic/boolean-simplifier.eta

(module boolean-simplifier
  (import std.io)
  (begin

    ;;@doc (non-pair? x)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;; ── Helpers ─────────────────────────────────────────────────────
    ;; non-pair? — true for anything that is not a pair (symbols, bools, etc.)
    ;;@example
    ;; (non-pair? 1)
    (defun non-pair? (x) (not (pair? x)))

    ;;@doc (op e)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;;@example
    ;; (op 'x)
    ;; Extract operator and arguments from an expression tree
    (defun op (e) (car e))
    ;;@doc (a1 e)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;; Compute `a1`.
    ;;@example
    ;; (a1 'x)
    (defun a1 (e) (car (cdr e)))
    ;;@doc (a2 e)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;; Compute `a2`.
    ;;@example
    ;; (a2 'x)
    (defun a2 (e) (car (cdr (cdr e))))

    ;;@doc (simplify-bool e)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;;@example
    ;; (simplify-bool 'x)
    ;; ── One-step simplifier ─────────────────────────────────────────
    (defun simplify-bool (e)
      (cond
        ;; Atoms (variables or constants) return as-is
        ((non-pair? e) e)

        ;; ── not ───────────────────────────────────────────────────
        ((eq? (op e) 'not)
          (let ((u (simplify-bool (a1 e))))
            (cond
              ((and (non-pair? u) (eq? u #t)) #f)
              ((and (non-pair? u) (eq? u #f)) #t)
              ;; Double negation: ¬(¬x) = x
              ((and (pair? u) (eq? (op u) 'not)) (a1 u))
              ;; De Morgan: ¬(a ∧ b) = (¬a) ∨ (¬b)
              ((and (pair? u) (eq? (op u) 'and))
                (list 'or  (list 'not (a1 u)) (list 'not (a2 u))))
              ;; De Morgan: ¬(a ∨ b) = (¬a) ∧ (¬b)
              ((and (pair? u) (eq? (op u) 'or))
                (list 'and (list 'not (a1 u)) (list 'not (a2 u))))
              (#t (list 'not u)))))

        ;; ── and ──────────────────────────────────────────────────
        ((eq? (op e) 'and)
          (let ((sa (simplify-bool (a1 e)))
                (sb (simplify-bool (a2 e))))
            (cond
              ((eq? sa #f) #f)           ; x ∧ ⊥ = ⊥
              ((eq? sb #f) #f)           ; ⊥ ∧ x = ⊥
              ((eq? sa #t) sb)           ; ⊤ ∧ x = x
              ((eq? sb #t) sa)           ; x ∧ ⊤ = x
              ((equal? sa sb) sa)        ; x ∧ x = x
              (#t (list 'and sa sb)))))

        ;; ── or ───────────────────────────────────────────────────
        ((eq? (op e) 'or)
          (let ((sa (simplify-bool (a1 e)))
                (sb (simplify-bool (a2 e))))
            (cond
              ((eq? sa #t) #t)           ; ⊤ ∨ x = ⊤
              ((eq? sb #t) #t)           ; x ∨ ⊤ = ⊤
              ((eq? sa #f) sb)           ; ⊥ ∨ x = x
              ((eq? sb #f) sa)           ; x ∨ ⊥ = x
              ((equal? sa sb) sa)        ; x ∨ x = x
              (#t (list 'or sa sb)))))

        ;; Anything else passes through unchanged
        (#t e)))

    ;;@doc (simplify-bool* e)
    ;;@category Logic
    ;;@module boolean-simplifier
    ;;@example
    ;; (simplify-bool* 'x)
    ;; ── Fixed-point wrapper: keep simplifying until stable ──────────
    (defun simplify-bool* (e)
      (let ((s (simplify-bool e)))
        (if (equal? s e) s (simplify-bool* s))))

    ;; ── Demonstrations ──────────────────────────────────────────────

    (define win (eq? (platform) 'Win32))

    (display (if win "x AND T           = " "x ∧ ⊤         = "))
    (println (simplify-bool* '(and x #t)))
    ;; => x

    (display (if win "x AND F           = " "x ∧ ⊥         = "))
    (println (simplify-bool* '(and x #f)))
    ;; => #f

    (display (if win "(T AND x) OR F    = " "(⊤ ∧ x) ∨ ⊥   = "))
    (println (simplify-bool* '(or (and #t x) #f)))
    ;; => x

    (display (if win "NOT(NOT y)        = " "¬(¬y)         = "))
    (println (simplify-bool* '(not (not y))))
    ;; => y

    (display (if win "NOT(a AND b)      = " "¬(a ∧ b)      = "))
    (println (simplify-bool* '(not (and a b))))
    ;; => (or (not a) (not b))

    (display (if win "NOT(a OR b)       = " "¬(a ∨ b)      = "))
    (println (simplify-bool* '(not (or a b))))
    ;; => (and (not a) (not b))

    (display (if win "(x OR x)          = " "(x ∨ x)       = "))
    (println (simplify-bool* '(or x x)))
    ;; => x

    (display (if win "NOT(NOT(p AND q)) = " "¬(¬(p ∧ q))   = "))
    (println (simplify-bool* '(not (not (and p q)))))
    ;; => (and p q)

  ))

