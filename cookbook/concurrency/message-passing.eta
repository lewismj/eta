;;; cookbook/concurrency/message-passing.eta - Basic PID-based actor messaging.
;;;
;;; Run:
;;;   etai cookbook/concurrency/message-passing.eta

(module message-passing
  (import std.actor std.io)
  (begin

    (define worker
      (spawn
        (lambda ()
          (let loop ()
            (receive
              (list
                (match-case
                  (match-list 'hello 1)
                  (lambda (msg)
                    (let ((from (car (cdr msg))))
                      (send from '(hello from-worker))
                      (loop))))
                (match-case
                  (match-list 'compute 2)
                  (lambda (msg)
                    (let ((from (car (cdr msg)))
                          (n (car (cdr (cdr msg)))))
                      (send from (list 'result n (* n 2)))
                      (loop))))
                (match-case
                  (match-symbol 'stop)
                  (lambda (msg)
                    'ok)))
              'wait)))))

    (send worker (list 'hello (self)))
    (println (receive-after 1000))

    (send worker (list 'compute (self) 21))
    (println (receive-after 1000))

    (send worker 'stop)))
