;;; cookbook/concurrency/parallel-map-worker.eta — Worker for parallel-map.eta
;;;
;;; One instance is spawned per input value.

(module parallel-map-worker
  (begin
    ;;@doc (mailbox)
    ;;@category Concurrency
    ;;@module parallel-map-worker
    ;; Worker for parallel-map.eta Uses `mailbox`.
    ;;@example
    ;; (display mailbox)
    (define mailbox (current-mailbox))
    (define task (recv! mailbox 'wait))
    (send! mailbox (* task 2) 'wait)))
