;;; cookbook/concurrency/parallel-fib.eta - Parallel Fibonacci with actor workers.
;;;
;;; Run:
;;;   etai cookbook/concurrency/parallel-fib.eta

(module parallel-fib
  (import std.actor std.collections std.io)
  (begin

    (defun %vector->list (vec)
      (let loop ((i 0) (acc '()))
        (if (= i (vector-length vec))
            (reverse acc)
            (loop (+ i 1) (cons (vector-ref vec i) acc)))))

    (defun fib (n)
      (let loop ((k n) (a 0) (b 1))
        (if (= k 0)
            a
            (loop (- k 1) b (+ a b)))))

    (define inputs '(25 26 27 28 29 30))
    (define indices (range 0 (length inputs)))

    (define workers
      (map
        (lambda (dummy)
          (spawn
            (lambda ()
              (receive
                (list
                  (match-case
                    (match-list 'fib-task 3)
                    (lambda (msg)
                      (let ((reply-to (car (cdr msg)))
                            (index (car (cdr (cdr msg))))
                            (value (car (cdr (cdr (cdr msg))))))
                        (send reply-to (list 'fib-result index (fib value)))))))
                'wait))))
        inputs))

    (let dispatch ((rest-workers workers) (rest-indices indices) (rest-values inputs))
      (when (and (pair? rest-workers)
                 (pair? rest-indices)
                 (pair? rest-values))
        (send (car rest-workers)
              (list 'fib-task (self) (car rest-indices) (car rest-values)))
        (dispatch (cdr rest-workers) (cdr rest-indices) (cdr rest-values))))

    (define results (make-vector (length inputs) 0))
    (let loop ((remaining (length inputs)))
      (when (> remaining 0)
        (let ((msg (receive-match (match-list 'fib-result 2) 1000)))
          (vector-set! results (car (cdr msg)) (car (cdr (cdr msg))))
          (loop (- remaining 1)))))

    (println (%vector->list results))))
