;;; cookbook/concurrency/parallel-map.eta - Parallel square-map using actors.
;;;
;;; Run:
;;;   etai cookbook/concurrency/parallel-map.eta

(module parallel-map
  (import std.actor std.collections std.io)
  (begin

    (defun %vector->list (vec)
      (let loop ((i 0) (acc '()))
        (if (= i (vector-length vec))
            (reverse acc)
            (loop (+ i 1) (cons (vector-ref vec i) acc)))))

    (define inputs '(1 2 3 4 5 6 7 8))
    (define indices (range 0 (length inputs)))

    (define workers
      (map
        (lambda (dummy)
          (spawn
            (lambda ()
              (receive
                (list
                  (match-case
                    (match-list 'map-task 3)
                    (lambda (msg)
                      (let ((reply-to (car (cdr msg)))
                            (index (car (cdr (cdr msg))))
                            (value (car (cdr (cdr (cdr msg))))))
                        (send reply-to (list 'map-result index (* value value)))))))
                'wait))))
        inputs))

    (let dispatch ((rest-workers workers) (rest-indices indices) (rest-values inputs))
      (when (and (pair? rest-workers)
                 (pair? rest-indices)
                 (pair? rest-values))
        (send (car rest-workers)
              (list 'map-task (self) (car rest-indices) (car rest-values)))
        (dispatch (cdr rest-workers) (cdr rest-indices) (cdr rest-values))))

    (define results (make-vector (length inputs) 0))
    (let loop ((remaining (length inputs)))
      (when (> remaining 0)
        (let ((msg (receive-match (match-list 'map-result 2) 1000)))
          (vector-set! results (car (cdr msg)) (car (cdr (cdr msg))))
          (loop (- remaining 1)))))

    (println (%vector->list results))))
