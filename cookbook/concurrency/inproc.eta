;;; cookbook/concurrency/inproc.eta - In-process actor workers with local mailboxes.
;;;
;;; Run:
;;;   etai cookbook/concurrency/inproc.eta

(module inproc
  (import std.actor std.collections std.io)
  (begin

    (defun %vector->list (vec)
      (let loop ((i 0) (acc '()))
        (if (= i (vector-length vec))
            (reverse acc)
            (loop (+ i 1) (cons (vector-ref vec i) acc)))))

    (defun make-worker (offset)
      (spawn
        (lambda ()
          (let loop ()
            (receive
              (list
                (match-case
                  (match-list 'add 3)
                  (lambda (msg)
                    (let ((from (car (cdr msg)))
                          (tag (car (cdr (cdr msg))))
                          (value (car (cdr (cdr (cdr msg))))))
                      (send from (list 'sum tag (+ value offset)))
                      (loop))))
                (match-case
                  (match-symbol 'stop)
                  (lambda (msg)
                    'ok)))
              'wait)))))

    (define workers
      (list
        (make-worker 10)
        (make-worker 20)
        (make-worker 30)))
    (define inputs '(5 6 7))
    (define tags (range 0 (length workers)))

    (let dispatch ((rest-workers workers) (rest-tags tags) (rest-values inputs))
      (when (and (pair? rest-workers)
                 (pair? rest-tags)
                 (pair? rest-values))
        (send (car rest-workers)
              (list 'add (self) (car rest-tags) (car rest-values)))
        (dispatch (cdr rest-workers) (cdr rest-tags) (cdr rest-values))))

    (define results (make-vector (length workers) 0))
    (let loop ((remaining (length workers)))
      (when (> remaining 0)
        (let ((msg (receive-match (match-list 'sum 2) 1000)))
          (vector-set! results (car (cdr msg)) (car (cdr (cdr msg))))
          (loop (- remaining 1)))))

    (println (%vector->list results))
    (for-each (lambda (worker) (send worker 'stop)) workers)))
