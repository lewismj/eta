;;; cookbook/concurrency/distributed-compute.eta - Client for remote REP compute service.
;;;
;;; Start server first:
;;;   etai cookbook/concurrency/distributed-compute-server.eta
;;;
;;; Then run:
;;;   etai cookbook/concurrency/distributed-compute.eta

(module distributed-compute
  (import std.net std.io)
  (begin

    (define endpoint "tcp://127.0.0.1:6000")
    (println (string-append "distributed-compute client -> " endpoint))

    (for-each
      (lambda (task)
        (let ((result (request-reply endpoint task)))
          (println (list 'task task 'result result))))
      '((square 5) (mul 6 7) (fib 20)))

    (println (request-reply endpoint '(shutdown)))))
