;;; cookbook/concurrency/pub-sub.eta - Actor pub/sub broker and subscribers.
;;;
;;; Run:
;;;   etai cookbook/concurrency/pub-sub.eta

(module pub-sub-demo
  (import std.actor std.io)
  (begin

    (defun %add-subscription (subs topic pid) (cons (cons topic pid) subs))

    (defun %publish (subs topic payload)
      (for-each
        (lambda (entry)
          (when (equal? (car entry) topic) (send (cdr entry) (list 'event topic payload))))
        subs))

    (defun make-broker ()
      (spawn
        (lambda ()
          (let
            loop
            ((subs '()))
            (receive
              (list
                (match-case
                  (match-list 'subscribe 2)
                  (lambda (msg)
                    (let ((pid (car (cdr msg))) (topic (car (cdr (cdr msg)))))
                      (send pid (list 'subscribed topic))
                      (loop (%add-subscription subs topic pid)))))
                (match-case
                  (match-list 'publish 2)
                  (lambda (msg)
                    (let ((topic (car (cdr msg))) (payload (car (cdr (cdr msg)))))
                      (%publish subs topic payload)
                      (loop subs))))
                (match-case (match-symbol 'stop) (lambda (msg) 'ok)))
              'wait)))))

    (defun make-subscriber (name topic broker parent)
      (spawn
        (lambda ()
          (send broker (list 'subscribe (self) topic))
          ;; Wait for the broker's ack so the parent never publishes before we are subscribed.
          (receive-match (match-list 'subscribed 1) 5000)
          (send parent (list 'ready name))
          (let
            loop
            ()
            (receive
              (list
                (match-case
                  (match-list 'event 2)
                  (lambda (msg)
                    (let ((seen-topic (car (cdr msg))) (payload (car (cdr (cdr msg)))))
                      (send parent (list 'seen name seen-topic payload))
                      (loop))))
                (match-case (match-symbol 'stop) (lambda (msg) 'ok)))
              'wait)))))

    (define broker (make-broker))
    (define price-sub (make-subscriber 'price-sub 'prices broker (self)))
    (define alert-sub (make-subscriber 'alert-sub 'alerts broker (self)))

    ;; Both subscribers must be registered before anything is published.
    (receive-match (match-list 'ready 1) 5000)
    (receive-match (match-list 'ready 1) 5000)

    ;; Publish one event at a time so the output order is deterministic.
    (defun publish-and-report (topic payload)
      (send broker (list 'publish topic payload))
      (println (receive-match (match-list 'seen 3) 5000)))

    (publish-and-report 'prices 100.5)
    (publish-and-report 'alerts "margin-call")
    (publish-and-report 'prices 101.1)

    (send price-sub 'stop)
    (send alert-sub 'stop)
    (send broker 'stop)))
