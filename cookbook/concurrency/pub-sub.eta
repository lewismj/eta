;;; cookbook/concurrency/pub-sub.eta - Actor pub/sub broker and subscribers.
;;;
;;; Run:
;;;   etai cookbook/concurrency/pub-sub.eta

(module pub-sub-demo
  (import std.actor std.io)
  (begin

    (defun %add-subscription (subs topic pid)
      (cons (cons topic pid) subs))

    (defun %publish (subs topic payload)
      (for-each
        (lambda (entry)
          (when (equal? (car entry) topic)
            (send (cdr entry) (list 'event topic payload))))
        subs))

    (defun make-broker ()
      (spawn
        (lambda ()
          (let loop ((subs '()))
            (receive
              (list
                (match-case
                  (match-list 'subscribe 2)
                  (lambda (msg)
                    (let ((pid (car (cdr msg)))
                          (topic (car (cdr (cdr msg)))))
                      (loop (%add-subscription subs topic pid)))))
                (match-case
                  (match-list 'publish 2)
                  (lambda (msg)
                    (let ((topic (car (cdr msg)))
                          (payload (car (cdr (cdr msg)))))
                      (%publish subs topic payload)
                      (loop subs))))
                (match-case
                  (match-symbol 'stop)
                  (lambda (msg)
                    'ok)))
              'wait)))))

    (defun make-subscriber (name topic broker parent)
      (spawn
        (lambda ()
          (send broker (list 'subscribe (self) topic))
          (let loop ()
            (receive
              (list
                (match-case
                  (match-list 'event 2)
                  (lambda (msg)
                    (let ((seen-topic (car (cdr msg)))
                          (payload (car (cdr (cdr msg)))))
                      (send parent (list 'seen name seen-topic payload))
                      (loop))))
                (match-case
                  (match-symbol 'stop)
                  (lambda (msg)
                    'ok)))
              'wait)))))

    (define broker (make-broker))
    (define price-sub (make-subscriber 'price-sub 'prices broker (self)))
    (define alert-sub (make-subscriber 'alert-sub 'alerts broker (self)))

    (send broker (list 'publish 'prices 100.5))
    (send broker (list 'publish 'alerts "margin-call"))
    (send broker (list 'publish 'prices 101.1))

    (println (receive-match (match-list 'seen 3) 1000))
    (println (receive-match (match-list 'seen 3) 1000))
    (println (receive-match (match-list 'seen 3) 1000))

    (send price-sub 'stop)
    (send alert-sub 'stop)
    (send broker 'stop)))
