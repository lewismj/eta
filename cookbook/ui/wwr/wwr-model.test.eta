;;; wwr-model.test.eta -- tests for the analytic WWR model behind the UI demo.
;;;
;;; Run: eta_test --path stdlib cookbook/ui/wwr/wwr-model.test.eta

(module wwr-model.tests
  (import std.test std.collections std.stats wwr-model)
  (begin

    (define cp17 (cp-ref "CP-17"))
    (define cp01 (cp-ref "CP-01"))
    (define base default-assumptions)
    (defun with (a k v) (hash-map-assoc a k v))
    (defun all? (pred xs) (or (null? xs) (and (pred (car xs)) (all? pred (cdr xs)))))
    (defun vec-all? (pred v) (all? pred (vector->list v)))

    ;; --------------------------------------------------------------
    ;; Distribution functions
    ;; --------------------------------------------------------------

    (define test-normal-cdf-known-values
      (make-test
        "normal-cdf matches reference values"
        (lambda ()
          (assert-approx-equal 0.5 (normal-cdf 0.0) 1e-7)
          (assert-approx-equal 0.9750021 (normal-cdf 1.96) 1e-6)
          (assert-approx-equal 0.8413447 (normal-cdf 1.0) 1e-6)
          (assert-approx-equal 0.0013499 (normal-cdf -3.0) 1e-6)
          (assert-approx-equal 0.0 (normal-cdf -9.0) 1e-9))))

    (define test-normal-cdf-symmetry-and-inverse
      (make-test
        "normal-cdf is symmetric and inverts stats:normal-quantile"
        (lambda ()
          (for-each
            (lambda (x) (assert-approx-equal 1.0 (+ (normal-cdf x) (normal-cdf (- x))) 1e-7))
            (list 0.1 0.7 1.5 2.5 4.0))
          (for-each
            (lambda (p) (assert-approx-equal p (normal-cdf (stats:normal-quantile p)) 2e-7))
            (list 0.001 0.05 0.3 0.5 0.8 0.99)))))

    (define test-expected-positive
      (make-test
        "expected-positive: limits and put-call parity"
        (lambda ()
          (assert-approx-equal 3.0 (expected-positive 3.0 0.0) 1e-12)
          (assert-approx-equal 0.0 (expected-positive -3.0 0.0) 1e-12)
          (assert-approx-equal (/ 2.0 2.5066282746310002) (expected-positive 0.0 2.0) 1e-9)
          (assert-approx-equal 50.0 (expected-positive 50.0 1.0) 1e-6)
          ;; E[X+] - E[(-X)+] = E[X]
          (for-each
            (lambda (m) (assert-approx-equal m (- (expected-positive m 1.7) (expected-positive (- m) 1.7)) 1e-6))
            (list -2.0 -0.3 0.0 0.4 3.0)))))

    ;; --------------------------------------------------------------
    ;; Book and market
    ;; --------------------------------------------------------------

    (define test-book
      (make-test
        "book has 30 counterparties with sane parameters"
        (lambda ()
          (assert-equal 30 (length counterparties))
          (assert-equal "CP-01" (hash-map-ref (car counterparties) 'name))
          (assert-equal #f (cp-ref "CP-99"))
          (assert-true (all? (lambda (cp) (> (hash-map-ref cp 'sigma) 0.0)) counterparties))
          (assert-true (all? (lambda (cp) (< 0.3 (hash-map-ref cp 'recovery) 0.5)) counterparties))
          (assert-approx-equal 2.91 (driver-beta cp17 "oil") 1e-12)
          (assert-approx-equal 0.0 (driver-beta cp17 "none") 1e-12))))

    (define test-time-grid
      (make-test
        "time grid is monthly to five years"
        (lambda ()
          (assert-equal steps (vector-length times))
          (assert-approx-equal (/ 5.0 60.0) (vector-ref times 0) 1e-12)
          (assert-approx-equal 5.0 (vector-ref times (- steps 1)) 1e-12))))

    (define test-shocked-hazard
      (make-test
        "macro shocks scale the hazard through the betas"
        (lambda ()
          (let ((h0 (shocked-hazard cp17 base))
                (up (shocked-hazard cp17 (with (with base 'driver "oil") 'shock 0.2)))
                (other (shocked-hazard cp17 (with (with base 'driver "eur-usd") 'shock 0.2))))
            (assert-approx-equal (hash-map-ref cp17 'hazard) h0 1e-12)
            (assert-approx-equal (* h0 (exp (* 2.91 0.2))) up 1e-12)
            (assert-true (< other up))))))

    ;; --------------------------------------------------------------
    ;; CVA and wrong-way risk
    ;; --------------------------------------------------------------

    (define test-rho-zero-is-independent
      (make-test
        "with rho = 0 the conditional exposure equals the unconditional EPE"
        (lambda ()
          (let* ((lam (shocked-hazard cp01 base))
                 (t 2.5)
                 (mom (exposure-moments cp01 base t)))
            (assert-approx-equal (expected-positive (car mom) (car (cdr mom)))
                                 (conditional-ee cp01 base 0.0 t lam) 1e-6)))))

    (define test-wrong-way-raises-cva
      (make-test
        "wrong-way correlation raises CVA, right-way lowers it"
        (lambda ()
          (let ((right (cva cp17 base -0.5))
                (indep (cva cp17 base 0.0))
                (wrong (cva cp17 base 0.5)))
            (assert-true (> indep 0.0))
            (assert-true (< right indep))
            (assert-true (> wrong indep))
            (assert-true (> (cva cp17 base 0.8) wrong))))))

    (define test-cva-scale
      (make-test
        "independent CVA is close to LGD x lambda x integrated discounted EPE"
        (lambda ()
          ;; For small hazards PD(dt) ~ lambda dt, so CVA ~ LGD lambda sum EPE dt.
          (let* ((a base)
                 (lam (shocked-hazard cp01 a))
                 (lgd (- 1.0 (hash-map-ref cp01 'recovery)))
                 (dt (/ 5.0 60.0))
                 (approx (* lgd lam dt
                            (foldl + 0.0
                                   (map (lambda (t)
                                          (let ((mom (exposure-moments cp01 a (- t (* 0.5 dt)))))
                                            (* (exp (* -0.0325 (- t (* 0.5 dt))))
                                               (expected-positive (car mom) (car (cdr mom))))))
                                        (vector->list times))))))
            (assert-approx-equal 1.0 (/ (cva cp01 a 0.0) approx) 0.05)))))

    (define test-collateral-reduces-cva
      (make-test
        "a CSA with a 10-day margin period cuts CVA sharply; a threshold adds back"
        (lambda ()
          (let* ((unc (cva cp01 base 0.3))
                 (csa (cva cp01 (with base 'collateralised #t) 0.3))
                 (csa-h (cva cp01 (with (with base 'collateralised #t) 'threshold 20000.0) 0.3))
                 (csa-long (cva cp01 (with (with base 'collateralised #t) 'mpor-days 20.0) 0.3)))
            (assert-true (< csa (* 0.25 unc)))
            (assert-true (< csa-h csa))
            (assert-true (> csa-long csa))))))

    (define test-elasticity-tracks-beta
      (make-test
        "with rho = 0 and small hazards, d log CVA / d shock is close to beta"
        (lambda ()
          (let ((a (with base 'rho 0.0)))
            (assert-approx-equal 2.91 (elasticity cp17 a "oil" 0.1) 0.15)
            (assert-true (> (elasticity cp17 a "oil" 0.1) (elasticity cp01 a "oil" 0.1)))))))

    (define test-elasticity-matrix-shape
      (make-test
        "elasticity matrix is 30 rows by 3 drivers"
        (lambda ()
          (let ((m (elasticity-matrix base)))
            (assert-equal 30 (length m))
            (assert-true (all? (lambda (row) (= 3 (length row))) m))))))

    ;; --------------------------------------------------------------
    ;; Profiles and surfaces
    ;; --------------------------------------------------------------

    (define test-profile
      (make-test
        "exposure profile: EPE >= 0 >= ENE, p05 <= p95, WWR above EPE for rho > 0"
        (lambda ()
          (let ((p (exposure-profile cp17 base)))
            (assert-equal steps (vector-length (hash-map-ref p 'epe)))
            (assert-true (vec-all? (lambda (x) (>= x 0.0)) (hash-map-ref p 'epe)))
            (assert-true (vec-all? (lambda (x) (<= x 0.0)) (hash-map-ref p 'ene)))
            (let loop ((k 0))
              (when (< k steps)
                (assert-true (<= (vector-ref (hash-map-ref p 'p05) k) (vector-ref (hash-map-ref p 'p95) k)))
                (assert-true (>= (+ (vector-ref (hash-map-ref p 'wwr) k) 1e-6) (vector-ref (hash-map-ref p 'epe) k)))
                (loop (+ k 1))))))))

    (define test-profile-rho-zero
      (make-test
        "with rho = 0 the WWR profile equals the EPE profile"
        (lambda ()
          (let ((p (exposure-profile cp01 (with base 'rho 0.0))))
            (let loop ((k 0))
              (when (< k steps)
                (assert-approx-equal (vector-ref (hash-map-ref p 'epe) k) (vector-ref (hash-map-ref p 'wwr) k) 1e-6)
                (loop (+ k 1))))))))

    (define test-surface
      (make-test
        "exposure surface: quantiles x times, non-negative, increasing in quantile"
        (lambda ()
          (let* ((s (exposure-surface cp17 base))
                 (rows (hash-map-ref s 'z))
                 (nt (vector-length (hash-map-ref s 'times))))
            (assert-equal (length surface-quantiles) (length rows))
            (assert-equal 30 nt)
            (assert-true (all? (lambda (row) (= nt (length row))) rows))
            (assert-true (all? (lambda (row) (all? (lambda (z) (>= z 0.0)) row)) rows))
            (let loop ((rs rows))
              (when (and (pair? rs) (pair? (cdr rs)))
                (assert-true (all? (lambda (pair) (<= (car pair) (cdr pair)))
                                   (map2 cons (car rs) (car (cdr rs)))))
                (loop (cdr rs))))))))

    (define test-portfolio-results
      (make-test
        "portfolio results: one row per counterparty, add-on sign follows rho"
        (lambda ()
          (let ((wrong (portfolio-results base))
                (right (portfolio-results (with base 'rho -0.4))))
            (assert-equal 30 (length wrong))
            (assert-true (all? (lambda (r) (> (hash-map-ref r 'addon) 0.0)) wrong))
            (assert-true (all? (lambda (r) (< (hash-map-ref r 'addon) 0.0)) right))
            (assert-true (all? (lambda (r) (> (hash-map-ref r 'base) 0.0)) wrong))))))

    (define suite
      (make-group
        "wwr-model"
        (list
          test-normal-cdf-known-values
          test-normal-cdf-symmetry-and-inverse
          test-expected-positive
          test-book
          test-time-grid
          test-shocked-hazard
          test-rho-zero-is-independent
          test-wrong-way-raises-cva
          test-cva-scale
          test-collateral-reduces-cva
          test-elasticity-tracks-beta
          test-elasticity-matrix-shape
          test-profile
          test-profile-rho-zero
          test-surface
          test-portfolio-results)))

    (print-tap (run suite))))
