(module blackjack_workbook
  (export workbook-overview workbook-steps run-step-1 run-step-2 run-step-3 run-workbook)
  (import std.core std.io std.collections blackjack)
  (begin

    (define %default-step-1-rounds 64)
    (define %default-step-1-workers 1)
    (define %default-step-3-epochs 8)
    (define %default-step-3-batch-size 32)
    (define %default-step-3-learning-rate 0.01)
    (define %default-step-3-policy-refresh 4)

    (defun %first-or (xs fallback)
      (if (null? xs)
          fallback
          (car xs)))

    (defun %alist-get (key rows)
      (let ((pair (assq key rows)))
        (if pair
            (cdr pair)
            #f)))

    (defun %join-with (parts sep)
      (if (null? parts)
          ""
          (let loop ((rest (cdr parts)) (acc (car parts)))
            (if (null? rest)
                acc
                (loop (cdr rest)
                      (string-append acc sep (car rest)))))))

    (defun %take-lines (text n)
      (let ((port (open-input-string text)))
        (let loop ((remaining n) (acc '()))
          (if (<= remaining 0)
              (begin
                (close-input-port port)
                (%join-with (reverse acc) "\n"))
              (let ((line (read-line port)))
                (if line
                    (loop (- remaining 1) (cons line acc))
                    (begin
                      (close-input-port port)
                      (%join-with (reverse acc) "\n"))))))))

    (defun %render-causal-row (row)
      (string-append
        "count="
        (number->string (%alist-get 'count row))
        ", ev-do(hit)="
        (display->string (%alist-get 'ev-do-hit row))
        ", ev-do(stand)="
        (display->string (%alist-get 'ev-do-stand row))
        ", policy="
        (symbol->string (%alist-get 'policy row))))

    (defun workbook-overview ()
      (string-append
        "blackjack workbook flow\n"
        "step-1: generate a tiny trace and summarize outcomes\n"
        "step-2: inspect a single causal decision sweep (16 vs 10)\n"
        "step-3: recover count weights and preview policy artifacts"))

    (defun workbook-steps ()
      (list
        "step-1 trace (blackjack/src/mc.eta): make-mc-shoe -> simulate -> simulate-summary"
        "step-2 causal (blackjack/src/causal.eta): make-causal-state -> sweep-do -> find-flip-threshold"
        "step-3 learning+policy (blackjack/src/learn.eta + strategy.eta + maxims.eta): recover-hi-lo-supervised -> render-strategy-chart -> render-maxim-clauses-for-count"))

    (defun run-step-1 (seed . rest)
      (let* ((rounds (%first-or rest %default-step-1-rounds))
             (workers (%first-or (cdr rest) %default-step-1-workers))
             (cfg (make-mc-shoe seed))
             (rows (simulate policy-hit-below-17 cfg rounds workers))
             (summary (simulate-summary rows)))
        (string-append
          "step-1: trace generation\n"
          "why: produce deterministic training data before any learning.\n"
          "implemented-in: blackjack/src/mc.eta\n"
          "calls: make-mc-shoe, simulate, simulate-summary\n"
          "seed="
          (number->string seed)
          ", rounds="
          (number->string rounds)
          ", workers="
          (number->string workers)
          "\nmean-reward="
          (display->string (%alist-get 'mean-reward summary))
          ", wins="
          (number->string (%alist-get 'wins summary))
          ", losses="
          (number->string (%alist-get 'losses summary))
          ", pushes="
          (number->string (%alist-get 'pushes summary)))))

    (defun run-step-2 (seed . rest)
      (let* ((player-total (%first-or rest 16))
             (dealer-up (%first-or (cdr rest) 10))
             (state (make-causal-state player-total dealer-up))
             (rows (sweep-do state default-count-buckets))
             (flip (find-flip-threshold state default-count-buckets))
             (row-lines (map* %render-causal-row rows)))
        (string-append
          "step-2: causal sweep\n"
          "why: test whether count changes the action under intervention.\n"
          "implemented-in: blackjack/src/causal.eta\n"
          "calls: make-causal-state, sweep-do, find-flip-threshold\n"
          "seed-context="
          (number->string seed)
          ", state=("
          (number->string player-total)
          ","
          (number->string dealer-up)
          ")\n"
          (%join-with row-lines "\n")
          "\nflip-threshold="
          (if flip
              (number->string flip)
              "none"))))

    (defun run-step-3 (seed . rest)
      (let* ((epochs (%first-or rest %default-step-3-epochs))
             (batch-size (%first-or (cdr rest) %default-step-3-batch-size))
             (learning-rate (%first-or (cdr (cdr rest))
                                       %default-step-3-learning-rate))
             (policy-refresh (%first-or (cdr (cdr (cdr rest)))
                                        %default-step-3-policy-refresh))
             (result (recover-hi-lo-supervised seed
                                               epochs
                                               batch-size
                                               learning-rate
                                               policy-refresh))
             (chart-preview (%take-lines (render-strategy-chart 0) 8))
             (maxims-preview (%take-lines (render-maxim-clauses-for-count 0) 8)))
        (string-append
          "step-3: learning and policy artifacts\n"
          "why: learn a count representation, then inspect chart and maxims.\n"
          "implemented-in: blackjack/src/learn.eta, blackjack/src/strategy.eta, blackjack/src/maxims.eta\n"
          "calls: recover-hi-lo-supervised, render-strategy-chart, render-maxim-clauses-for-count\n"
          "seed="
          (number->string seed)
          ", epochs="
          (number->string epochs)
          ", batch-size="
          (number->string batch-size)
          ", learning-rate="
          (display->string learning-rate)
          ", policy-refresh="
          (number->string policy-refresh)
          "\ncosine-hi-lo="
          (display->string (learn-result-cosine-hi-lo result))
          ", ev-monotone="
          (display->string (learn-result-ev-monotone result))
          "\nweights="
          (display->string (learn-result-normalized-weights result))
          "\nchart-preview:\n"
          chart-preview
          "\nmaxims-preview:\n"
          maxims-preview)))

    (defun run-workbook (seed)
      (%join-with
        (list
          (workbook-overview)
          (run-step-1 seed)
          (run-step-2 seed)
          (run-step-3 seed))
        "\n\n"))

  ))
