{
    "$schema": "vscode://schemas/color-theme",
    "name": "Eta Dark",
    "type": "dark",
    "colors": {
        "editor.background": "#1d2128",
        "editor.foreground": "#e7e2dc",
        "editorLineNumber.foreground": "#8a9099",
        "editorLineNumber.activeForeground": "#fb8aa7",
        "editorCursor.foreground": "#fb8aa7",
        "editor.selectionBackground": "#d97a9226",
        "editor.inactiveSelectionBackground": "#fb8aa722",
        "editor.lineHighlightBackground": "#2a3038",
        "editor.lineHighlightBorder": "#2a3038",
        "editorWhitespace.foreground": "#3a4048",
        "editorIndentGuide.background1": "#3a4048",
        "editorIndentGuide.activeBackground1": "#fb8aa755",
        "editorBracketMatch.background": "#fb8aa722",
        "editorBracketMatch.border": "#fb8aa7",
        "editorBracketHighlight.foreground1": "#fb8aa7",
        "editorBracketHighlight.foreground2": "#f0a4bc",
        "editorBracketHighlight.foreground3": "#e4c1ca",
        "editorBracketHighlight.foreground4": "#d7b0bb",
        "editorBracketHighlight.foreground5": "#879caf",
        "editorBracketHighlight.foreground6": "#9f8668",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff6b6b",
        "editorWidget.background": "#20252e",
        "editorWidget.border": "#3a4048",
        "editorHoverWidget.background": "#20252e",
        "editorHoverWidget.border": "#3a4048",
        "editorSuggestWidget.background": "#20252e",
        "editorSuggestWidget.border": "#3a4048",
        "editorSuggestWidget.selectedBackground": "#d97a9226",
        "editorSuggestWidget.highlightForeground": "#fb8aa7",
        "editorGroupHeader.tabsBackground": "#171b21",
        "editorGroupHeader.border": "#3a4048",
        "tab.activeBackground": "#1d2128",
        "tab.activeForeground": "#e7e2dc",
        "tab.activeBorderTop": "#879caf",
        "tab.inactiveBackground": "#171b21",
        "tab.inactiveForeground": "#8a9099",
        "tab.border": "#3a4048",
        "activityBar.background": "#171b21",
        "activityBar.foreground": "#e7e2dc",
        "activityBar.inactiveForeground": "#9aa1ab",
        "activityBar.activeBorder": "#879caf",
        "activityBarBadge.background": "#8ea1b5",
        "activityBarBadge.foreground": "#1d2128",
        "sideBar.background": "#171b21",
        "sideBar.foreground": "#e7e2dc",
        "sideBar.border": "#3a4048",
        "sideBarSectionHeader.background": "#20252e",
        "sideBarSectionHeader.foreground": "#e7e2dc",
        "sideBarTitle.foreground": "#e7e2dc",
        "list.activeSelectionBackground": "#8ea1b526",
        "list.activeSelectionForeground": "#e7e2dc",
        "list.inactiveSelectionBackground": "#8ea1b522",
        "list.hoverBackground": "#252a33",
        "list.highlightForeground": "#8ea1b5",
        "statusBar.background": "#2b3442",
        "statusBar.foreground": "#d8dee8",
        "statusBar.border": "#3c4658",
        "statusBar.debuggingBackground": "#3a4658",
        "statusBar.debuggingForeground": "#d8dee8",
        "statusBar.noFolderBackground": "#2b3442",
        "statusBarItem.remoteBackground": "#879caf",
        "statusBarItem.remoteForeground": "#1d2128",
        "titleBar.activeBackground": "#171b21",
        "titleBar.activeForeground": "#e7e2dc",
        "titleBar.inactiveBackground": "#171b21",
        "titleBar.inactiveForeground": "#8a9099",
        "titleBar.border": "#3a4048",
        "panel.background": "#171b21",
        "panel.border": "#3a4048",
        "panelTitle.activeForeground": "#e7e2dc",
        "panelTitle.activeBorder": "#879caf",
        "panelTitle.inactiveForeground": "#8a9099",
        "terminal.background": "#1d2128",
        "terminal.foreground": "#e7e2dc",
        "terminal.ansiBlack": "#1d2128",
        "terminal.ansiRed": "#ff6b6b",
        "terminal.ansiGreen": "#a8c8a8",
        "terminal.ansiYellow": "#9f8668",
        "terminal.ansiBlue": "#879caf",
        "terminal.ansiMagenta": "#cf7c92",
        "terminal.ansiCyan": "#c8a2bb",
        "terminal.ansiWhite": "#e7e2dc",
        "terminal.ansiBrightBlack": "#9aa1ab",
        "terminal.ansiBrightRed": "#ff8a8a",
        "terminal.ansiBrightGreen": "#c0d8c0",
        "terminal.ansiBrightYellow": "#b89a78",
        "terminal.ansiBrightBlue": "#9fb2c3",
        "terminal.ansiBrightMagenta": "#d59aac",
        "terminal.ansiBrightCyan": "#dcc4d8",
        "terminal.ansiBrightWhite": "#ffffff",
        "button.background": "#879caf",
        "button.foreground": "#1d2128",
        "button.hoverBackground": "#9fb2c3",
        "input.background": "#20252e",
        "input.foreground": "#e7e2dc",
        "input.border": "#3a4048",
        "inputOption.activeBorder": "#879caf",
        "focusBorder": "#879caf",
        "scrollbarSlider.background": "#8ea1b526",
        "scrollbarSlider.hoverBackground": "#879caf40",
        "scrollbarSlider.activeBackground": "#879caf66",
        "badge.background": "#879caf",
        "badge.foreground": "#1d2128",
        "progressBar.background": "#879caf",
        "errorForeground": "#ff6b6b",
        "editorError.foreground": "#ff6b6b",
        "editorWarning.foreground": "#9f8668",
        "editorInfo.foreground": "#8ea1b5",
        "charts.red": "#ff6b6b",
        "charts.blue": "#8ea1b5",
        "charts.yellow": "#9f8668",
        "charts.orange": "#b98c9c",
        "charts.green": "#a8c8a8",
        "charts.purple": "#cf7c92",
        "diffEditor.insertedTextBackground": "#a8c8a822",
        "diffEditor.removedTextBackground": "#ff6b6b22",
        "gitDecoration.modifiedResourceForeground": "#9f8668",
        "gitDecoration.addedResourceForeground": "#a8c8a8",
        "gitDecoration.deletedResourceForeground": "#ff6b6b",
        "gitDecoration.untrackedResourceForeground": "#879caf",
        "debugIcon.breakpointForeground": "#fb8aa7",
        "debugToolBar.background": "#171b21"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.line.semicolon.eta",
                "comment.line.semicolon.eta-bytecode",
                "comment.block.eta",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#8a9099", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.eta",
                "string.quoted.double",
                "string.quoted.single",
                "string.quoted.double.eta-bytecode"
            ],
            "settings": { "foreground": "#e6d3d8" }
        },
        {
            "scope": [
                "constant.character",
                "constant.character.eta",
                "constant.character.escape",
                "constant.character.escape.eta",
                "constant.character.escape.eta-bytecode"
            ],
            "settings": { "foreground": "#e4c1ca" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.eta",
                "constant.numeric.hex.eta",
                "constant.numeric.octal.eta",
                "constant.numeric.binary.eta",
                "constant.language.boolean",
                "constant.language.boolean.eta",
                "constant.language",
                "constant.numeric.line.eta-bytecode",
                "constant.numeric.index.eta-bytecode",
                "constant.numeric.decimal.eta-bytecode",
                "constant.numeric.hex.eta-bytecode",
                "constant.numeric.reference.eta-bytecode",
                "constant.language.eta-bytecode"
            ],
            "settings": { "foreground": "#e4c1ca" }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.function.eta-bytecode"
            ],
            "settings": { "foreground": "#c7ced8", "fontStyle": "" }
        },
        {
            "scope": [
                "keyword.control.core.eta",
                "keyword.control.binding.eta",
                "keyword.control.conditional.eta",
                "keyword.control.module.eta",
                "keyword.control",
                "keyword"
            ],
            "settings": { "foreground": "#c97b8f" }
        },
        {
            "scope": [
                "keyword.control.macro.eta",
                "keyword.control.record.eta",
                "keyword.control.sugar.eta",
                "keyword.control.advanced.eta"
            ],
            "settings": { "foreground": "#b98c9c" }
        },
        {
            "scope": [
                "keyword.operator.opcode.eta-bytecode",
                "keyword.control.section.eta-bytecode"
            ],
            "settings": { "foreground": "#8ea1b5" }
        },
        {
            "scope": ["keyword.control.exception.eta"],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.control.logic.eta",
                "keyword.control.relational.eta"
            ],
            "settings": { "foreground": "#879caf" }
        },
        {
            "scope": ["keyword.control.supervisor.eta"],
            "settings": { "foreground": "#9f8668" }
        },
        {
            "scope": ["keyword.operator.quote.eta", "keyword.operator"],
            "settings": { "foreground": "#a19a94", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.function.builtin.eta",
                "support.function.predicate.eta",
                "support.function.math.eta",
                "support.function",
                "support.function.reference.eta-bytecode"
            ],
            "settings": { "foreground": "#c7ced8" }
        },
        {
            "scope": ["support.function.io.eta"],
            "settings": { "foreground": "#879caf" }
        },
        {
            "scope": ["support.function.ad.eta"],
            "settings": { "foreground": "#fb8aa7", "fontStyle": "bold" }
        },
        {
            "scope": ["support.function.clp.eta"],
            "settings": { "foreground": "#9f8668" }
        },
        {
            "scope": ["support.function.torch.eta"],
            "settings": { "foreground": "#9f8668" }
        },
        {
            "scope": ["support.function.nng.eta"],
            "settings": { "foreground": "#9f8668" }
        },
        {
            "scope": ["support.function.test.eta"],
            "settings": { "foreground": "#879caf" }
        },
        {
            "scope": ["variable.other.logic.eta"],
            "settings": { "foreground": "#9f8668", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.eta", "variable.other", "variable"],
            "settings": { "foreground": "#e7e2dc" }
        },
        {
            "scope": [
                "punctuation.paren.open.eta",
                "punctuation.paren.close.eta",
                "punctuation.definition.vector.eta",
                "punctuation.definition.bytevector.eta",
                "punctuation",
                "punctuation.separator.key-value.eta-bytecode",
                "punctuation.definition.bracket.begin.eta-bytecode",
                "punctuation.definition.bracket.end.eta-bytecode"
            ],
            "settings": { "foreground": "#9aa1ab" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff6b6b", "fontStyle": "underline" }
        }
    ]
}
