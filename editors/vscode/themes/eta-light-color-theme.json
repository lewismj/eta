{
    "$schema": "vscode://schemas/color-theme",
    "name": "Eta Light",
    "type": "light",
    "colors": {
        "editor.background": "#f5f5f4",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#a8a6a1",
        "editorLineNumber.activeForeground": "#c2185b",
        "editorCursor.foreground": "#c2185b",
        "editor.selectionBackground": "#fb8aa755",
        "editor.inactiveSelectionBackground": "#fb8aa733",
        "editor.lineHighlightBackground": "#ebe9e4",
        "editor.lineHighlightBorder": "#ebe9e4",
        "editorWhitespace.foreground": "#d8d6d1",
        "editorIndentGuide.background1": "#e2e0db",
        "editorIndentGuide.activeBackground1": "#fb8aa7",
        "editorBracketMatch.background": "#fb8aa733",
        "editorBracketMatch.border": "#c2185b",
        "editorBracketHighlight.foreground1": "#c2185b",
        "editorBracketHighlight.foreground2": "#6a3fb5",
        "editorBracketHighlight.foreground3": "#b89500",
        "editorBracketHighlight.foreground4": "#3f7d3f",
        "editorBracketHighlight.foreground5": "#1f6fb5",
        "editorBracketHighlight.foreground6": "#c45a2c",
        "editorBracketHighlight.unexpectedBracket.foreground": "#c0392b",
        "editorWidget.background": "#ffffff",
        "editorWidget.border": "#d8d6d1",
        "editorHoverWidget.background": "#ffffff",
        "editorHoverWidget.border": "#d8d6d1",
        "editorSuggestWidget.background": "#ffffff",
        "editorSuggestWidget.border": "#d8d6d1",
        "editorSuggestWidget.selectedBackground": "#fb8aa733",
        "editorSuggestWidget.highlightForeground": "#c2185b",
        "editorGroupHeader.tabsBackground": "#ebe9e4",
        "editorGroupHeader.border": "#d8d6d1",
        "tab.activeBackground": "#f5f5f4",
        "tab.activeForeground": "#000000",
        "tab.activeBorderTop": "#fb8aa7",
        "tab.inactiveBackground": "#ebe9e4",
        "tab.inactiveForeground": "#5b5b5b",
        "tab.border": "#d8d6d1",
        "activityBar.background": "#ebe9e4",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#707070",
        "activityBar.activeBorder": "#c2185b",
        "activityBarBadge.background": "#fb8aa7",
        "activityBarBadge.foreground": "#000000",
        "sideBar.background": "#ebe9e4",
        "sideBar.foreground": "#000000",
        "sideBar.border": "#d8d6d1",
        "sideBarSectionHeader.background": "#e2e0db",
        "sideBarSectionHeader.foreground": "#000000",
        "sideBarTitle.foreground": "#000000",
        "list.activeSelectionBackground": "#fb8aa755",
        "list.activeSelectionForeground": "#000000",
        "list.inactiveSelectionBackground": "#fb8aa733",
        "list.hoverBackground": "#e2e0db",
        "list.highlightForeground": "#c2185b",
        "statusBar.background": "#ebe9e4",
        "statusBar.foreground": "#000000",
        "statusBar.border": "#d8d6d1",
        "statusBar.debuggingBackground": "#fb8aa7",
        "statusBar.debuggingForeground": "#000000",
        "statusBar.noFolderBackground": "#ebe9e4",
        "statusBarItem.remoteBackground": "#fb8aa7",
        "statusBarItem.remoteForeground": "#000000",
        "titleBar.activeBackground": "#ebe9e4",
        "titleBar.activeForeground": "#000000",
        "titleBar.inactiveBackground": "#ebe9e4",
        "titleBar.inactiveForeground": "#5b5b5b",
        "titleBar.border": "#d8d6d1",
        "panel.background": "#ebe9e4",
        "panel.border": "#d8d6d1",
        "panelTitle.activeForeground": "#000000",
        "panelTitle.activeBorder": "#fb8aa7",
        "panelTitle.inactiveForeground": "#5b5b5b",
        "terminal.background": "#f5f5f4",
        "terminal.foreground": "#000000",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#c0392b",
        "terminal.ansiGreen": "#3f7d3f",
        "terminal.ansiYellow": "#b89500",
        "terminal.ansiBlue": "#1f6fb5",
        "terminal.ansiMagenta": "#c2185b",
        "terminal.ansiCyan": "#6a3fb5",
        "terminal.ansiWhite": "#f5f5f4",
        "terminal.ansiBrightBlack": "#707070",
        "terminal.ansiBrightRed": "#e74c3c",
        "terminal.ansiBrightGreen": "#5ba85b",
        "terminal.ansiBrightYellow": "#d6a900",
        "terminal.ansiBrightBlue": "#2e8bd6",
        "terminal.ansiBrightMagenta": "#fb8aa7",
        "terminal.ansiBrightCyan": "#8a5fd6",
        "terminal.ansiBrightWhite": "#ffffff",
        "button.background": "#fb8aa7",
        "button.foreground": "#000000",
        "button.hoverBackground": "#c2185b",
        "input.background": "#ffffff",
        "input.foreground": "#000000",
        "input.border": "#d8d6d1",
        "inputOption.activeBorder": "#fb8aa7",
        "focusBorder": "#fb8aa7",
        "scrollbarSlider.background": "#fb8aa755",
        "scrollbarSlider.hoverBackground": "#fb8aa777",
        "scrollbarSlider.activeBackground": "#fb8aa799",
        "badge.background": "#fb8aa7",
        "badge.foreground": "#000000",
        "progressBar.background": "#fb8aa7",
        "errorForeground": "#c0392b",
        "editorError.foreground": "#c0392b",
        "editorWarning.foreground": "#b89500",
        "editorInfo.foreground": "#1f6fb5",
        "diffEditor.insertedTextBackground": "#3f7d3f22",
        "diffEditor.removedTextBackground": "#c0392b22",
        "gitDecoration.modifiedResourceForeground": "#b89500",
        "gitDecoration.addedResourceForeground": "#3f7d3f",
        "gitDecoration.deletedResourceForeground": "#c0392b",
        "gitDecoration.untrackedResourceForeground": "#1f6fb5",
        "debugIcon.breakpointForeground": "#c2185b",
        "debugToolBar.background": "#ebe9e4"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block",
                "comment.line.semicolon.eta",
                "comment.block.eta",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#5b5b5b", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "string.quoted.double.eta",
                "string.quoted.double",
                "string.quoted.single"
            ],
            "settings": { "foreground": "#3f7d3f" }
        },
        {
            "scope": [
                "constant.character",
                "constant.character.eta",
                "constant.character.escape",
                "constant.character.escape.eta"
            ],
            "settings": { "foreground": "#5ba85b" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.eta",
                "constant.numeric.hex.eta",
                "constant.numeric.octal.eta",
                "constant.numeric.binary.eta",
                "constant.language.boolean",
                "constant.language.boolean.eta",
                "constant.language"
            ],
            "settings": { "foreground": "#1f6fb5" }
        },
        {
            "scope": [
                "keyword.control.core.eta",
                "keyword.control.binding.eta",
                "keyword.control.conditional.eta",
                "keyword.control.module.eta",
                "keyword.control",
                "keyword"
            ],
            "settings": { "foreground": "#c2185b" }
        },
        {
            "scope": [
                "keyword.control.macro.eta",
                "keyword.control.record.eta",
                "keyword.control.sugar.eta",
                "keyword.control.advanced.eta"
            ],
            "settings": { "foreground": "#d6447f" }
        },
        {
            "scope": ["keyword.control.exception.eta"],
            "settings": { "foreground": "#c0392b", "fontStyle": "bold" }
        },
        {
            "scope": [
                "keyword.control.logic.eta",
                "keyword.control.relational.eta"
            ],
            "settings": { "foreground": "#6a3fb5" }
        },
        {
            "scope": ["keyword.control.supervisor.eta"],
            "settings": { "foreground": "#b89500" }
        },
        {
            "scope": ["keyword.operator.quote.eta", "keyword.operator"],
            "settings": { "foreground": "#c2185b", "fontStyle": "italic" }
        },
        {
            "scope": [
                "support.function.builtin.eta",
                "support.function.predicate.eta",
                "support.function.math.eta",
                "support.function"
            ],
            "settings": { "foreground": "#b89500" }
        },
        {
            "scope": ["support.function.io.eta"],
            "settings": { "foreground": "#1f6fb5" }
        },
        {
            "scope": ["support.function.ad.eta"],
            "settings": { "foreground": "#c2185b", "fontStyle": "bold" }
        },
        {
            "scope": ["support.function.clp.eta"],
            "settings": { "foreground": "#6a3fb5" }
        },
        {
            "scope": ["support.function.torch.eta"],
            "settings": { "foreground": "#c45a2c" }
        },
        {
            "scope": ["support.function.nng.eta"],
            "settings": { "foreground": "#b89500" }
        },
        {
            "scope": ["support.function.test.eta"],
            "settings": { "foreground": "#3f7d3f" }
        },
        {
            "scope": ["variable.other.logic.eta"],
            "settings": { "foreground": "#6a3fb5", "fontStyle": "italic" }
        },
        {
            "scope": ["variable.other.eta", "variable.other", "variable"],
            "settings": { "foreground": "#000000" }
        },
        {
            "scope": [
                "punctuation.paren.open.eta",
                "punctuation.paren.close.eta",
                "punctuation.definition.vector.eta",
                "punctuation.definition.bytevector.eta",
                "punctuation"
            ],
            "settings": { "foreground": "#5b5b5b" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#c0392b", "fontStyle": "underline" }
        }
    ]
}

